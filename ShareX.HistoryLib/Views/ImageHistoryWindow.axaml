<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.HistoryLib.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:history="using:ShareX.HistoryLib"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="ShareX.HistoryLib.ImageHistoryWindow"
        Title="{x:Static localization:Strings.HistoryWindows_ShareX_Image_History}"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ListBox.thumbnail-rows">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.thumbnail-rows ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.thumbnail-rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.thumbnail-card">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.thumbnail-header">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style Selector="Border.thumbnail-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
        </Style>
        <Style Selector="Border.thumbnail-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
        </Style>
        <Style Selector="TextBox.dialog-multiline">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Styles>

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid Margin="16,0,16,16" RowDefinitions="Auto,*" RowSpacing="12">
                <Border Grid.Row="0"
                        Classes="tool-panel docked-top-toolbar">
                    <Grid ColumnDefinitions="280,Auto,Auto,Auto,Auto,*">
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchTextBox"
                                     PlaceholderText="{x:Static localization:Strings.HistoryWindows_Search_file_names_and_tags}"
                                     TextChanged="OnSearchTextChanged"
                                     Padding="12,7,38,7"/>
                            <TextBlock Text="{x:Static theming:LucideIcons.search}"
                                       Classes="icon"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Button x:Name="FavoritesButton" Grid.Column="1" Click="OnFavoritesClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.star}"/>
                                <TextBlock Text="{x:Static localization:Strings.HistoryWindows_Favorites}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OnStatsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.chart_bar}"/>
                                <TextBlock Text="{x:Static localization:Strings.HistoryWindows_Stats}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Click="OnImportClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.folder_search}"/>
                                <TextBlock Text="{x:Static localization:Strings.HistoryWindows_Import}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Click="OnSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.settings}"/>
                                <TextBlock Text="{x:Static localization:Strings.HistoryWindows_Settings}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ItemCountText"
                                   Grid.Column="5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                        <ListBox x:Name="ThumbnailRows"
                                 Classes="thumbnail-rows"
                                 SelectionMode="Single"
                                 SizeChanged="OnThumbnailRowsSizeChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="history:ImageHistoryRow">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="history:ImageHistoryEntry">
                                                <Border Classes="thumbnail-card"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Width="{Binding CardWidth}"
                                                        AttachedToVisualTree="OnThumbnailAttached"
                                                        DetachedFromVisualTree="OnThumbnailDetached"
                                                        DataContextChanged="OnThumbnailDataContextChanged"
                                                        PointerPressed="OnThumbnailPointerPressed"
                                                        PointerMoved="OnThumbnailPointerMoved"
                                                        PointerReleased="OnThumbnailPointerReleased"
                                                        DoubleTapped="OnThumbnailDoubleTapped">
                                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                                        <Border Grid.Row="0"
                                                                Classes="thumbnail-header"
                                                                IsVisible="{Binding ShowHeaderTop}"
                                                                CornerRadius="3,3,0,0">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontWeight="Normal"
                                                                       TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Item.FilePath}"/>
                                                        </Border>
                                                        <Border Grid.Row="1"
                                                                Height="{Binding ThumbnailHeight}"
                                                                Background="{DynamicResource ShareX.Brush.Background.Panel}"
                                                                CornerRadius="{Binding ThumbnailCornerRadius}"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="Uniform"
                                                                       StretchDirection="DownOnly"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                                <StackPanel IsVisible="{Binding ShowPlaceholder}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Spacing="6">
                                                                    <TextBlock Text="{x:Static theming:LucideIcons.image}"
                                                                               Classes="icon"
                                                                               FontSize="30"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                                                    <TextBlock Text="{x:Static localization:Strings.HistoryWindows_Loading}"
                                                                               IsVisible="{Binding IsLoading}"
                                                                               FontWeight="Normal"
                                                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{x:Static theming:LucideIcons.star}"
                                                                           Classes="icon"
                                                                           IsVisible="{Binding IsFavorite}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Top"
                                                                           Margin="6"
                                                                           Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="2"
                                                                Classes="thumbnail-header"
                                                                IsVisible="{Binding ShowHeaderBottom}"
                                                                CornerRadius="0,0,3,3">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontWeight="Normal"
                                                                       TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Item.FilePath}"/>
                                                        </Border>
                                                    </Grid>

                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Open_image}" Click="OnShowImageClick" InputGesture="Enter">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.image}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Open}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.external_link}"/>
                                                                </MenuItem.Icon>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_URL}" Click="OnOpenUrlClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Shortened_URL}" Click="OnOpenShortUrlClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Thumbnail_URL}" Click="OnOpenThumbnailUrlClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Deletion_URL}" Click="OnOpenDeletionUrlClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_File}" Click="OnOpenFileClick" InputGesture="Ctrl+Enter"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Folder}" Click="OnOpenFolderClick" InputGesture="Shift+Enter"/>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Copy}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.copy}"/>
                                                                </MenuItem.Icon>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_URL}" Click="OnCopyUrlClick" InputGesture="Ctrl+C"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Shortened_URL}" Click="OnCopyShortUrlClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Thumbnail_URL}" Click="OnCopyThumbnailUrlClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Deletion_URL}" Click="OnCopyDeletionUrlClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_File}" Click="OnCopyFileClick" InputGesture="Shift+C"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Image}" Click="OnCopyImageClick" InputGesture="Alt+C"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Text}" Click="OnCopyTextClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_HTML_link}" Click="OnCopyHtmlLinkClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_File_path}" Click="OnCopyFilePathClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_File_name}" Click="OnCopyFileNameClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_File_name_with_extension}" Click="OnCopyFileNameWithExtensionClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Folder}" Click="OnCopyFolderClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_HTML_image}" Click="OnCopyHtmlImageClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_HTML_linked_image}" Click="OnCopyHtmlLinkedImageClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Forum_link}" Click="OnCopyForumLinkClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Forum_image}" Click="OnCopyForumImageClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Forum_linked_image}" Click="OnCopyForumLinkedImageClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Markdown_link}" Click="OnCopyMarkdownLinkClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Markdown_image}" Click="OnCopyMarkdownImageClick"/>
                                                                <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Markdown_linked_image}" Click="OnCopyMarkdownLinkedImageClick"/>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Toggle_favorite}" Click="OnToggleFavoriteClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.star}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Edit_tag}" Click="OnEditTagClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.tag}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Edit_item}" Click="OnEditItemClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.square_pen}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Rename_file}" Click="OnRenameFileClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.file_pen_line}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Delete_from_history}" Click="OnDeleteClick" InputGesture="Delete">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.list_x}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Delete_file_and_history_item}" Click="OnDeleteFileClick" InputGesture="Shift+Delete">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.file_x}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Upload_file}" Click="OnUploadFileClick" InputGesture="Ctrl+U">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.upload}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Edit_image}" Click="OnEditImageClick" InputGesture="Ctrl+E">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.wand_sparkles}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Pin_to_screen}" Click="OnPinToScreenClick" InputGesture="Ctrl+P">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.pin}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{x:Static localization:Strings.HistoryWindows_Analyze_image}" Click="OnAnalyzeImageClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.scan_search}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="False"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{x:Static theming:LucideIcons.images}"
                                       Classes="icon"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                            <TextBlock x:Name="EmptyStateText"
                                       Text="{x:Static localization:Strings.HistoryWindows_No_image_history_items}"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                        </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="ModalOverlay"
                  IsVisible="False"
                  Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border x:Name="StatsDialog" Classes="tool-panel" Width="640" Height="540" Padding="18"
                        IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.HistoryWindows_History_statistics}"/>
                        <TextBox x:Name="StatsTextBox" Grid.Row="1" Classes="dialog-multiline" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <Button Grid.Row="2" Content="{x:Static localization:Strings.HistoryWindows_Close}" HorizontalAlignment="Right" Click="OnCloseModalClick"/>
                    </Grid>
                </Border>

                <Border x:Name="ImportDialog" Classes="tool-panel" Width="540" Padding="18"
                        IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.HistoryWindows_Import_folder}"/>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ImportFolderTextBox" PlaceholderText="{x:Static localization:Strings.HistoryWindows_Folder_path}" TextChanged="OnImportFolderTextChanged"/>
                            <Button Grid.Column="1" Content="{x:Static localization:Strings.HistoryWindows_Browse}" Click="OnBrowseImportFolderClick"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <CheckBox x:Name="ImportImagesOnlyCheckBox" Content="{x:Static localization:Strings.HistoryWindows_Only_import_image_files}" IsChecked="True"/>
                            <CheckBox x:Name="ImportSkipDuplicatesCheckBox" Content="{x:Static localization:Strings.HistoryWindows_Skip_duplicate_files}" IsChecked="True"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportStatusText" Grid.Row="3" FontWeight="Normal"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="ImportConfirmButton" Content="{x:Static localization:Strings.HistoryWindows_Import}" Click="OnImportConfirmClick" IsEnabled="False"/>
                            <Button Content="{x:Static localization:Strings.HistoryWindows_Cancel}" Click="OnCloseModalClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="SettingsDialog" Classes="tool-panel" Width="480" MaxHeight="650" Padding="18"
                        IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                        <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.HistoryWindows_Image_history_settings}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="170,*" RowSpacing="10" ColumnSpacing="10" Margin="0,0,8,0">
                                <TextBlock Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Thumbnail_width}"/>
                                <NumericUpDown x:Name="ThumbnailWidthInput" Grid.Column="1" Minimum="32" Maximum="800" Increment="10"/>
                                <TextBlock Grid.Row="1" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Thumbnail_height}"/>
                                <NumericUpDown x:Name="ThumbnailHeightInput" Grid.Row="1" Grid.Column="1" Minimum="32" Maximum="800" Increment="10"/>
                                <TextBlock Grid.Row="2" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Thumbnail_header}"/>
                                <ComboBox x:Name="ThumbnailHeaderPositionCombo" Grid.Row="2" Grid.Column="1">
                                    <ComboBoxItem Content="{x:Static localization:Strings.HistoryWindows_None}"/>
                                    <ComboBoxItem Content="{x:Static localization:Strings.HistoryWindows_Top}"/>
                                    <ComboBoxItem Content="{x:Static localization:Strings.HistoryWindows_Bottom}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Items_per_batch}"/>
                                <NumericUpDown x:Name="BatchSizeInput" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100000" Increment="50"/>
                                <ToggleSwitch x:Name="AutoLoadMoreToggle" Grid.Row="4" Grid.ColumnSpan="2" Content="{x:Static localization:Strings.HistoryWindows_Load_the_next_batch_near_the_end}"/>
                                <ToggleSwitch x:Name="FilterMissingToggle" Grid.Row="5" Grid.ColumnSpan="2" Content="{x:Static localization:Strings.HistoryWindows_Hide_missing_files}"/>
                                <ToggleSwitch x:Name="ImageOnlyToggle" Grid.Row="6" Grid.ColumnSpan="2" Content="{x:Static localization:Strings.HistoryWindows_Show_image_files_only}"/>
                                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Spacing="10">
                                    <ToggleSwitch x:Name="RememberSearchToggle" Content="{x:Static localization:Strings.HistoryWindows_Remember_search_text}"/>
                                    <ToggleSwitch x:Name="RememberWindowToggle" Content="{x:Static localization:Strings.HistoryWindows_Remember_window_size_and_position}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="{x:Static localization:Strings.HistoryWindows_Done}" HorizontalAlignment="Right" Click="OnSaveSettingsClick"/>
                    </Grid>
                </Border>

                <Border x:Name="EditDialog" Classes="tool-panel" Width="700" MaxHeight="650" Padding="18"
                        IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.HistoryWindows_Edit_history_item}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="120,*" RowSpacing="8" ColumnSpacing="10" Margin="0,0,8,0">
                                <TextBlock Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_File_name}"/>
                                <TextBox x:Name="EditFileNameTextBox" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_File_path}"/>
                                <TextBox x:Name="EditFilePathTextBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Date}"/>
                                <TextBox x:Name="EditDateTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True"/>
                                <TextBlock Grid.Row="3" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Type}"/>
                                <TextBox x:Name="EditTypeTextBox" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Host}"/>
                                <TextBox x:Name="EditHostTextBox" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_URL}"/>
                                <TextBox x:Name="EditUrlTextBox" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Thumbnail_URL}"/>
                                <TextBox x:Name="EditThumbnailUrlTextBox" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Deletion_URL}"/>
                                <TextBox x:Name="EditDeletionUrlTextBox" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Shortened_URL}"/>
                                <TextBox x:Name="EditShortUrlTextBox" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Classes="row-label" Text="{x:Static localization:Strings.HistoryWindows_Tags}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <TextBox x:Name="EditTagsTextBox" Grid.Row="9" Grid.Column="1" Classes="dialog-multiline"
                                         Height="110" AcceptsReturn="True" TextWrapping="NoWrap" PlaceholderText="{x:Static localization:Strings.HistoryWindows_One_key_value_pair_per_line}"/>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{x:Static localization:Strings.HistoryWindows_Save}" Click="OnSaveEditClick"/>
                            <Button Content="{x:Static localization:Strings.HistoryWindows_Cancel}" Click="OnCloseModalClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="PromptDialog" Classes="tool-panel" Width="480" Padding="18"
                        IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock x:Name="PromptTitle" Classes="section-heading"/>
                        <TextBlock x:Name="PromptMessage" Grid.Row="1" FontWeight="Normal" TextWrapping="Wrap"/>
                        <TextBox x:Name="PromptTextBox" Grid.Row="2" IsVisible="False"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="PromptConfirmButton" Content="{x:Static localization:Strings.HistoryWindows_OK}" Click="OnPromptConfirmClick"/>
                            <Button Content="{x:Static localization:Strings.HistoryWindows_Cancel}" Click="OnCloseModalClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
</Window>
