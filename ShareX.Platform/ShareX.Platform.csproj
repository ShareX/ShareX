<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShareX.Platform</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <Description>Platform agnostic service interfaces used by ShareX on Windows, macOS and Linux.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShareX.Platform.Tests" />
  </ItemGroup>
</Project>
