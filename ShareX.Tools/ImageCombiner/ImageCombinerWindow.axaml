<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools.ImageCombiner"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="650"
        x:Class="ShareX.Tools.ImageCombiner.ImageCombinerWindow"
        x:DataType="vm:ImageCombinerViewModel"
        Title="ShareX - Image Combiner"
        Width="980"
        Height="650"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="440,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="tool-panel" Padding="12">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Command="{Binding AddCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Static theming:LucideIcons.plus}"
                                                   FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                        <TextBlock Text="Add..."/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}">
                                    <TextBlock Text="{x:Static theming:LucideIcons.trash_2}"
                                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}">
                                    <TextBlock Text="{x:Static theming:LucideIcons.arrow_up}"
                                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}">
                                    <TextBlock Text="{x:Static theming:LucideIcons.arrow_down}"
                                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                </Button>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding ImageCountText}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="ImagesList"
                                         ItemsSource="{Binding Images}"
                                         SelectedItem="{Binding SelectedImage}"
                                         SelectionMode="Multiple"
                                         SelectionChanged="OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,3">
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static theming:LucideIcons.image}"
                                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel IsVisible="{Binding !HasImages}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{x:Static theming:LucideIcons.square_dashed}"
                                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                               FontWeight="Normal"
                                               FontSize="42"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drop images here or use the Add button"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                        <Border Grid.Row="0" Classes="tool-panel" Padding="16">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Classes="section-heading" Text="Layout"/>
                                <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="Orientation"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <RadioButton GroupName="Orientation" IsChecked="{Binding IsHorizontal}">
                                            <TextBlock Text="Horizontal" FontWeight="Normal"/>
                                        </RadioButton>
                                        <RadioButton GroupName="Orientation" IsChecked="{Binding IsVertical}">
                                            <TextBlock Text="Vertical" FontWeight="Normal"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="120,*,120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="Alignment"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AlignmentOptions}"
                                              SelectedIndex="{Binding SelectedAlignmentIndex}"/>
                                    <TextBlock Grid.Column="2" Classes="row-label" Text="Spacing"/>
                                    <NumericUpDown Grid.Column="3"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   FormatString="0"
                                                   Value="{Binding Space}"/>
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="120,*,120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="Wrap after"/>
                                    <NumericUpDown Grid.Column="1"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   FormatString="0"
                                                   Value="{Binding WrapAfter}"/>
                                    <CheckBox Grid.Column="2" Grid.ColumnSpan="2"
                                              IsChecked="{Binding AutoFillBackground}"
                                              VerticalAlignment="Center">
                                        <TextBlock Text="Auto fill background" FontWeight="Normal"/>
                                    </CheckBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="tool-panel" Padding="16" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <StackPanel IsVisible="{Binding !HasPreview}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="{x:Static theming:LucideIcons.images}"
                                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                               FontWeight="Normal"
                                               FontSize="46"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add at least two images to preview"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto" HorizontalAlignment="Right">
                    <Button Grid.Column="0"
                            Command="{Binding CombineCommand}"
                            IsEnabled="{Binding CanCombine}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static theming:LucideIcons.combine}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                       FontWeight="Normal"/>
                            <TextBlock Text="Combine images"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
