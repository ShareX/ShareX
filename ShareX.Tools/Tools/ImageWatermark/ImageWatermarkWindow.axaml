<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        xmlns:controls="using:ShareX.Tools.Controls"
        xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d" d:DesignWidth="1220" d:DesignHeight="700"
        x:Class="ShareX.Tools.ImageWatermarkWindow"
        x:DataType="vm:ImageWatermarkViewModel"
        Title="{x:Static localization:Strings.ImageWatermarkWindow_Image_watermark}"
        Width="1220"
        Height="700"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
        <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="340,360,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="tool-panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Command="{Binding AddCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Static theming:LucideIcons.plus}" Classes="icon"/>
                                    <TextBlock Text="{x:Static localization:Strings.ImageThumbnailerWindow_Add}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}">
                                <TextBlock Text="{x:Static theming:LucideIcons.trash_2}" Classes="icon"/>
                            </Button>
                            <TextBlock Grid.Column="2" Text="{Binding ImageCountText}"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ImagesList"
                                     ItemsSource="{Binding Images}"
                                     SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,3">
                                            <TextBlock Text="{x:Static theming:LucideIcons.image}"
                                                       Classes="icon"
                                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel IsVisible="{Binding !HasImages}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" IsHitTestVisible="False">
                                <TextBlock Text="{x:Static theming:LucideIcons.square_dashed}"
                                           Classes="icon" FontSize="42"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static localization:Strings.ImageThumbnailerWindow_Drop_images_here_or_use_the_Add_button}"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Border Classes="tool-panel" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-heading"
                                           Text="{x:Static localization:Strings.ImageWatermarkWindow_Watermark}"/>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <TextBlock Classes="row-label"
                                               Text="{x:Static localization:Strings.ImageWatermarkWindow_Watermark_type}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding WatermarkTypeOptions}"
                                              SelectedIndex="{Binding SelectedWatermarkTypeIndex}"/>
                                </Grid>

                                <StackPanel Spacing="10" IsVisible="{Binding IsTextWatermark}">
                                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label"
                                                   Text="{x:Static localization:Strings.DirectoryIndexerViewModel_Text}"/>
                                        <TextBox Grid.Column="1" Text="{Binding WatermarkText}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label"
                                                   Text="{x:Static localization:Strings.ImageWatermarkWindow_Font_size}"/>
                                        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="500" FormatString="0"
                                                       Value="{Binding TextSize}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label"
                                                   Text="{x:Static localization:Strings.MonitorTestWindow_Color}"/>
                                        <cp:ColorPicker Grid.Column="1" Color="{Binding TextColor, Mode=TwoWay}"
                                                        HorizontalAlignment="Left"
                                                        IsAlphaEnabled="False" IsAlphaVisible="False"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10" IsVisible="{Binding IsImageWatermark}">
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="row-label"
                                                   Text="{x:Static localization:Strings.AnalyzeImageWindow_Image}"/>
                                        <TextBlock Grid.Column="1" Classes="path-text" Text="{Binding WatermarkImagePath}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Command="{Binding BrowseWatermarkImageCommand}"
                                                Content="{x:Static localization:Strings.ImageThumbnailerWindow_Browse}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                        <TextBlock Classes="row-label"
                                                   Text="{x:Static localization:Strings.ImageWatermarkWindow_Scale}"/>
                                        <Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding ImageScale}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ImageScale, StringFormat={}{0:0}%}"
                                                   MinWidth="40" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <TextBlock Classes="row-label" Text="{x:Static localization:Strings.ImageWatermarkWindow_Position}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PositionOptions}"
                                              SelectedIndex="{Binding SelectedPositionIndex}"/>
                                </Grid>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <TextBlock Classes="row-label"
                                               Text="{x:Static localization:Strings.ImageWatermarkWindow_Margin}"/>
                                    <NumericUpDown Grid.Column="1" Minimum="0" Maximum="10000" FormatString="0"
                                                   Value="{Binding Margin}"/>
                                </Grid>
                                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                    <TextBlock Classes="row-label" Text="{x:Static localization:Strings.InspectWindowWindow_Opacity}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Opacity}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:0}%}"
                                               MinWidth="40" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                    <TextBlock Classes="row-label"
                                               Text="{x:Static localization:Strings.ImageWatermarkWindow_Rotation}"/>
                                    <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Rotation}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Rotation, StringFormat={}{0:0}°}"
                                               MinWidth="40" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="tool-panel" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-heading"
                                           Text="{x:Static localization:Strings.ImageThumbnailerWindow_Output}"/>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <TextBlock Classes="row-label" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Output_format}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding OutputFormatOptions}"
                                              SelectedIndex="{Binding SelectedOutputFormatIndex}"/>
                                </Grid>
                                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsJpeg}">
                                    <TextBlock Classes="row-label" Text="{x:Static localization:Strings.ImageThumbnailerWindow_JPEG_quality}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Quality}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Quality, StringFormat={}{0:0}%}"
                                               MinWidth="40" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10" IsVisible="{Binding IsJpeg}">
                                    <TextBlock Classes="row-label" Text="{x:Static localization:Strings.PinToScreenOptionsWindow_Background_color}"/>
                                    <cp:ColorPicker Grid.Column="1" Color="{Binding BackgroundColor, Mode=TwoWay}"
                                                    HorizontalAlignment="Left"
                                                    IsAlphaEnabled="False" IsAlphaVisible="False"/>
                                </Grid>
                                <TextBlock Classes="row-label"
                                           Text="{x:Static localization:Strings.ImageThumbnailerWindow_File_name_template}"/>
                                <TextBox Text="{Binding OutputFileName}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="path-text" Text="{Binding OutputFolderPath}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding BrowseOutputFolderCommand}"
                                            Content="{x:Static localization:Strings.ImageThumbnailerWindow_Browse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="tool-panel" IsVisible="{Binding HasMessage}">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Classes="tool-panel" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                                BorderBrush="{DynamicResource ShareX.Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding PreviewFilePath}" Classes="path-text"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PreviewSizeText}"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ProgressBar Grid.Row="1" IsVisible="{Binding IsPreviewLoading}"
                                     IsIndeterminate="True" Height="4"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top" ZIndex="1"/>
                        <Grid Grid.Row="1">
                            <controls:ImageComparisonSlider RightImage="{Binding PreviewImage}" Margin="12"/>
                            <TextBlock Text="{x:Static theming:LucideIcons.image}"
                                       IsVisible="{Binding !HasImages}"
                                       Classes="icon" FontSize="54"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="1" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static theming:LucideIcons.stamp}" Classes="icon"/>
                    <TextBlock Text="{x:Static localization:Strings.ImageWatermarkWindow_Apply_watermark}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
