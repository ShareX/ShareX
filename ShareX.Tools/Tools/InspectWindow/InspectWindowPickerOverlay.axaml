<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.Tools.InspectWindowPickerOverlay"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        Background="#19000000"
        TransparencyLevelHint="Transparent">
        <Grid Background="#19000000">
            <Border Classes="tool-panel"
                    Padding="18,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Static theming:LucideIcons.crosshair}"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"
                               FontSize="20"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="InstructionText"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
</Window>
