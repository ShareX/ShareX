<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="650"
        x:Class="ShareX.Tools.ImageCombinerWindow"
        x:DataType="vm:ImageCombinerViewModel"
        Title="{x:Static localization:Strings.ImageCombinerWindow_ShareX_Image_Combiner}"
        Width="980"
        Height="650"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="440,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="tool-panel" Padding="12">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Command="{Binding AddCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Plus}"/>
                                        <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Add}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Trash}"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.ArrowUp}"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.ArrowDown}"/>
                                </Button>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding ImageCountText}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="ImagesList"
                                         ItemsSource="{Binding Images}"
                                         SelectedItem="{Binding SelectedImage}"
                                         SelectionMode="Multiple"
                                         SelectionChanged="OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,3">
                                                <controls:IconPresenter Grid.Column="0"
                                                                        Icon="{x:Static icons:AppIcons.Image}"
                                                                        Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel IsVisible="{Binding !HasImages}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsHitTestVisible="False">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.DragDropUpload}"
                                                            FontSize="42"
                                                            Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Drop_images_here_or_use_the_Add_button}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                        <Border Grid.Row="0" Classes="tool-panel" Padding="16">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Classes="section-heading" Text="{x:Static localization:Strings.ImageCombinerWindow_Layout}"/>
                                <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="{x:Static localization:Strings.ImageCombinerWindow_Orientation}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <RadioButton GroupName="Orientation" IsChecked="{Binding IsHorizontal}">
                                            <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Horizontal}" FontWeight="Normal"/>
                                        </RadioButton>
                                        <RadioButton GroupName="Orientation" IsChecked="{Binding IsVertical}">
                                            <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Vertical}" FontWeight="Normal"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="120,*,120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="{x:Static localization:Strings.ImageCombinerWindow_Alignment}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AlignmentOptions}"
                                              SelectedIndex="{Binding SelectedAlignmentIndex}"/>
                                    <TextBlock Grid.Column="2" Classes="row-label" Text="{x:Static localization:Strings.ImageCombinerWindow_Spacing}"/>
                                    <NumericUpDown Grid.Column="3"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   FormatString="0"
                                                   Value="{Binding Space}"/>
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="120,*,120,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="row-label" Text="{x:Static localization:Strings.ImageCombinerWindow_Wrap_after}"/>
                                    <NumericUpDown Grid.Column="1"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   FormatString="0"
                                                   Value="{Binding WrapAfter}"/>
                                    <CheckBox Grid.Column="2" Grid.ColumnSpan="2"
                                              IsChecked="{Binding AutoFillBackground}"
                                              VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Auto_fill_background}" FontWeight="Normal"/>
                                    </CheckBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="tool-panel" Padding="16" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <StackPanel IsVisible="{Binding !HasPreview}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Images}"
                                                            FontSize="46"
                                                            Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Add_at_least_two_images_to_preview}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto" HorizontalAlignment="Right">
                    <Button Grid.Column="0"
                            Command="{Binding CombineCommand}"
                            IsEnabled="{Binding CanCombine}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.Combine}"/>
                            <TextBlock Text="{x:Static localization:Strings.ImageCombinerWindow_Combine_images}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
</Window>
