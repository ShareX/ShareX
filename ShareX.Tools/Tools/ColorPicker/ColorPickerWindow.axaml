<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ShareX.Tools.Controls"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.Tools.ColorPickerWindow"
        Title="ShareX - Color picker"
        Width="790" MinWidth="760" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid Margin="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="370,*" ColumnSpacing="12">
                    <Border Classes="tool-panel">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <controls:AdvancedColorPickerControl x:Name="Picker"
                                                                 Width="342" Height="300"
                                                                 HorizontalAlignment="Center"/>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Color mode" FontWeight="Normal" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PickerModeComboBox" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="OnPickerModeChanged">
                                    <ComboBoxItem Content="Hue"/>
                                    <ComboBoxItem Content="Saturation"/>
                                    <ComboBoxItem Content="Brightness"/>
                                    <ComboBoxItem Content="Red"/>
                                    <ComboBoxItem Content="Green"/>
                                    <ComboBoxItem Content="Blue"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Border Classes="tool-panel">
                            <Border.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="TextBlock.preview-label">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                                <Style Selector="TextBox">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="NumericUpDown">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </Border.Styles>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Color name" FontWeight="Normal"/>
                                        <TextBox x:Name="ColorNameText" IsReadOnly="True" IsTabStop="False"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Hex" FontWeight="Normal" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="HexValue" TextAlignment="Center" TextChanged="OnHexTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Decimal" FontWeight="Normal" HorizontalAlignment="Center"/>
                                        <NumericUpDown x:Name="DecimalValue" Minimum="0" Maximum="16777215"
                                                       FormatString="0" ShowButtonSpinner="False"
                                                       HorizontalContentAlignment="Center"
                                                       ValueChanged="OnDecimalValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4"><TextBlock Text="Red" FontWeight="Normal"/><NumericUpDown x:Name="RedValue" Minimum="0" Maximum="255" ShowButtonSpinner="False" ValueChanged="OnRgbValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Green" FontWeight="Normal"/><NumericUpDown x:Name="GreenValue" Minimum="0" Maximum="255" ShowButtonSpinner="False" ValueChanged="OnRgbValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Blue" FontWeight="Normal"/><NumericUpDown x:Name="BlueValue" Minimum="0" Maximum="255" ShowButtonSpinner="False" ValueChanged="OnRgbValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="Alpha" FontWeight="Normal"/>
                                        <NumericUpDown x:Name="AlphaValue" Minimum="0" Maximum="255" ShowButtonSpinner="False" ValueChanged="OnRgbValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4"><TextBlock Text="Hue °" FontWeight="Normal"/><NumericUpDown x:Name="HueValue" Minimum="0" Maximum="360" ShowButtonSpinner="False" ValueChanged="OnHsbValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Saturation %" FontWeight="Normal"/><NumericUpDown x:Name="SaturationValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnHsbValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Brightness %" FontWeight="Normal"/><NumericUpDown x:Name="BrightnessValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnHsbValueChanged"/></StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4"><TextBlock Text="Cyan %" FontWeight="Normal"/><NumericUpDown x:Name="CyanValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnCmykValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Magenta %" FontWeight="Normal"/><NumericUpDown x:Name="MagentaValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnCmykValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Yellow %" FontWeight="Normal"/><NumericUpDown x:Name="YellowValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnCmykValueChanged"/></StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="Key %" FontWeight="Normal"/><NumericUpDown x:Name="KeyValue" Minimum="0" Maximum="100" ShowButtonSpinner="False" ValueChanged="OnCmykValueChanged"/></StackPanel>
                                </Grid>

                                <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Current" FontWeight="Normal"/>
                                        <Border Height="40" Background="{DynamicResource ShareX.Brush.Checkered.Small}"
                                                BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" ClipToBounds="True">
                                            <Border x:Name="NewColorPreview" CornerRadius="4"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Previous" FontWeight="Normal"/>
                                        <Border Height="40" Background="{DynamicResource ShareX.Brush.Checkered.Small}"
                                                BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="1"
                                                CornerRadius="4" ClipToBounds="True"
                                                PointerPressed="OnPreviousColorPressed">
                                            <Border x:Name="OldColorPreview" CornerRadius="4" IsVisible="False"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Copy all details" Click="OnCopyAllClick"/>
                                                <MenuItem Header="Copy RGB" Click="OnCopyRgbClick"/>
                                                <MenuItem Header="Copy hexadecimal" Click="OnCopyHexClick"/>
                                                <MenuItem Header="Copy HSB" Click="OnCopyHsbClick"/>
                                                <MenuItem Header="Copy CMYK" Click="OnCopyCmykClick"/>
                                                <MenuItem Header="Copy decimal" Click="OnCopyDecimalClick"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.copy}"/><TextBlock Text="Copy"/><TextBlock Classes="icon" FontSize="11" Text="{x:Static theming:LucideIcons.chevron_down}"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Classes="tool-panel" Width="370" HorizontalAlignment="Left">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="RecentPalette" Content="Recent colors" GroupName="PaletteMode" Click="OnPaletteChanged"/>
                            <RadioButton x:Name="StandardPalette" Content="Standard colors" GroupName="PaletteMode" Click="OnPaletteChanged"/>
                        </StackPanel>
                        <WrapPanel x:Name="PalettePanel" Grid.Row="1" ItemWidth="21" ItemHeight="21"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Click="OnPickScreenClick">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.pipette}"/><TextBlock Text="Pick color from screen..."/></StackPanel>
                    </Button>
                    <Button Click="OnClipboardClick">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.clipboard_paste}"/><TextBlock Text="Pick color from clipboard"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
