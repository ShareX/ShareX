<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:local="using:ShareX.Tools"
        xmlns:loc="using:ShareX.Tools.Localization"
        x:Class="ShareX.Tools.VideoTrimmerWindow"
        x:DataType="local:VideoTrimmerViewModel"
        Title="{x:Static loc:Strings.VideoTrimmer_Title}"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        Width="900" Height="720" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
        <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Border Classes="tool-panel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="section-heading" Text="{x:Static loc:Strings.VideoThumbnailerWindow_Video}"/>
                    <TextBlock Grid.Column="1" Classes="path-text" Text="{Binding InputDisplay}"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding InputFilePath}"/>
                    <Button Grid.Column="2" Command="{Binding BrowseCommand}" IsEnabled="{Binding CanBrowse}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.FolderOpen}"/>
                            <TextBlock Text="{x:Static loc:Strings.VideoTrimmer_Open}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="tool-panel">
                <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <Border Classes="video-preview" Classes.has-video="{Binding HasVideo}" CornerRadius="4" ClipToBounds="True">
                        <Border.Styles>
                            <Style Selector="Border.video-preview">
                                <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
                            </Style>
                            <Style Selector="Border.video-preview.has-video">
                                <Setter Property="Background" Value="Black"/>
                            </Style>
                        </Border.Styles>
                        <Grid>
                            <local:WindowsMediaPlayer x:Name="Player" IsVisible="{Binding HasVideo}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel IsVisible="{Binding !HasVideo}" Spacing="12"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.Film}"
                                                        FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.VideoTrimmer_ChooseVideo}" FontWeight="Normal"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding StepBackwardCommand}" IsEnabled="{Binding CanEdit}" Width="40"
                                        ToolTip.Tip="{x:Static loc:Strings.AnimatedGifTrimmer_PreviousFrame}"
                                        AutomationProperties.Name="{x:Static loc:Strings.AnimatedGifTrimmer_PreviousFrame}">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.StepBack}"/>
                                </Button>
                                <Button Command="{Binding TogglePlayCommand}" IsEnabled="{Binding CanEdit}" Width="40"
                                        ToolTip.Tip="{Binding PlayActionText}" AutomationProperties.Name="{Binding PlayActionText}">
                                    <Grid>
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Play}" IsVisible="{Binding !IsPlaying}"/>
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Pause}" IsVisible="{Binding IsPlaying}"/>
                                    </Grid>
                                </Button>
                                <Button Command="{Binding StepForwardCommand}" IsEnabled="{Binding CanEdit}" Width="40"
                                        ToolTip.Tip="{x:Static loc:Strings.AnimatedGifTrimmer_NextFrame}"
                                        AutomationProperties.Name="{x:Static loc:Strings.AnimatedGifTrimmer_NextFrame}">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.StepForward}"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PositionText}" FontWeight="Normal" Foreground="{DynamicResource ShareX.Brush.Text}"/>
                                <TextBlock Text="/" FontWeight="Normal"/>
                                <TextBlock Text="{Binding DurationText}" FontWeight="Normal"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="5" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                               FontWeight="Normal" TextWrapping="Wrap"/>

                    <local:VideoTrimmerTimeline Grid.Row="2" Height="72" IsEnabled="{Binding CanEdit}"
                                               Accent="{DynamicResource ShareX.Brush.Accent}"
                                               TrackBackground="{DynamicResource ShareX.Brush.Control.Background}"
                                               AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_Timeline}"/>

                    <ProgressBar Grid.Row="3" Height="4" IsVisible="{Binding IsWorking}"
                                 IsIndeterminate="{Binding IsLoading}" Value="{Binding Progress}"/>

                    <Grid Grid.Row="4" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding CanEdit}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="row-label" Text="{x:Static loc:Strings.VideoTrimmer_Start}"/>
                            <TextBox Grid.Column="1" Text="{Binding StartTimeText, Mode=OneWay}"
                                     TextAlignment="Center" LostFocus="OnStartTimeLostFocus" KeyDown="OnStartTimeKeyDown"
                                     AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_Start}"/>
                            <Button Grid.Column="2" Command="{Binding SetStartCommand}" Width="40"
                                    ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_SetStart}"
                                    AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_SetStart}">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.ArrowLeftToLine}"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="row-label" Text="{x:Static loc:Strings.VideoTrimmer_End}"/>
                            <TextBox Grid.Column="1" Text="{Binding EndTimeText, Mode=OneWay}"
                                     TextAlignment="Center" LostFocus="OnEndTimeLostFocus" KeyDown="OnEndTimeKeyDown"
                                     AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_End}"/>
                            <Button Grid.Column="2" Command="{Binding SetEndCommand}" Width="40"
                                    ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_SetEnd}"
                                    AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_SetEnd}">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.ArrowRightToLine}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="row-label" Text="{x:Static loc:Strings.VideoTrimmer_Duration}"/>
                            <TextBlock Text="{Binding SelectionDurationText}" FontWeight="Normal"
                                       Foreground="{DynamicResource ShareX.Brush.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="3" Command="{Binding ResetCommand}" Width="40"
                                ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_Reset}"
                                AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_Reset}">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.Reset}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="tool-panel">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="16">
                    <TextBlock Classes="row-label" Text="{x:Static loc:Strings.VideoTrimmer_TrimMode}"/>
                    <RadioButton Grid.Column="1" GroupName="TrimMode" IsChecked="{Binding Lossless, Mode=TwoWay}"
                                 IsEnabled="{Binding CanBrowse}" VerticalAlignment="Center"
                                 ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_CopyHint}">
                        <TextBlock Text="{x:Static loc:Strings.VideoTrimmer_Lossless}" FontWeight="Normal"/>
                    </RadioButton>
                    <RadioButton Grid.Column="2" GroupName="TrimMode" IsChecked="{Binding Precise, Mode=TwoWay}"
                                 IsEnabled="{Binding CanBrowse}" VerticalAlignment="Center"
                                 ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_PreciseHint}">
                        <TextBlock Text="{x:Static loc:Strings.VideoTrimmer_Precise}" FontWeight="Normal"/>
                    </RadioButton>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Command="{Binding PrimaryActionCommand}" IsEnabled="{Binding CanUsePrimaryAction}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.Scissors}"
                                                        IsVisible="{Binding !IsExporting}"/>
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.Close}"
                                                        IsVisible="{Binding IsExporting}"/>
                                <TextBlock Text="{Binding PrimaryActionText}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenOutputCommand}" IsEnabled="{Binding HasOutput}" Width="40"
                                ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_ShowOutput}"
                                AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_ShowOutput}">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.FolderOpen}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
