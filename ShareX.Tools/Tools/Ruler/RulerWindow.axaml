<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:controls="using:ShareX.Tools.Controls"
        x:Class="ShareX.Tools.RulerWindow"
        Title="{x:Static localization:Strings.RulerWindow_ShareX_Ruler}"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="{DynamicResource ShareX.FontFamily.Default}">

    <controls:RulerOverlayControl x:Name="RulerOverlay"
                                  AccentColor="{DynamicResource ShareX.Color.Accent.Start}"/>
</Window>
