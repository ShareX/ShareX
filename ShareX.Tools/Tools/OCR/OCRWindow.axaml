<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:toolControls="using:ShareX.Tools.Controls"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="ShareX.Tools.OCRWindow"
        x:DataType="vm:OCRViewModel"
        Title="{x:Static localization:Strings.OCRWindow_ShareX_Optical_character_recognition}"
        Width="1100"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Command="{Binding SelectRegionCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.Crop}"/>
                            <TextBlock Text="{x:Static localization:Strings.OCRWindow_Select_region}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding SelectImageCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.Image}"/>
                            <TextBlock Text="{x:Static localization:Strings.OCRWindow_Select_image}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="5*,12,4*">
                    <Border Grid.Column="0" Classes="tool-panel" Padding="0" ClipToBounds="True">
                        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
                            <toolControls:OCRPreview Margin="16"
                                                     Source="{Binding SourceImage}"
                                                     Regions="{Binding TextRegions}"
                                                     HighlightBrush="{DynamicResource ShareX.Brush.Accent}"
                                                     ImageBorderBrush="{DynamicResource ShareX.Brush.Border}"/>
                            <ProgressBar Height="4"
                                         VerticalAlignment="Top"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Background="Transparent"
                                  ResizeDirection="Columns"/>

                    <Border Grid.Column="2" Classes="tool-panel" Padding="0" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,10,10">
                                <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.OCRWindow_Result}"/>
                                <Button Grid.Column="1" Command="{Binding CopyAllCommand}" IsEnabled="{Binding CanUseResult}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Copy}"/>
                                        <TextBlock Text="{x:Static localization:Strings.OCRWindow_Copy_all}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Margin="12,0,12,12">
                                <TextBox Text="{Binding ResultText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontSize="14"
                                         FontFeatures="-calt, -liga"
                                         IsEnabled="{Binding IsIdle}"/>
                                <StackPanel IsVisible="{Binding NoTextFound}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            IsHitTestVisible="False">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.TextRecognition}"
                                                            FontSize="34"
                                                            Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Static localization:Strings.OCRWindow_No_text_found}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HasError}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="380"
                                            Spacing="10"
                                            IsHitTestVisible="False">
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Warning}"
                                                            FontSize="34"
                                                            Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="20">
                    <CheckBox Grid.Column="0"
                              Content="{x:Static localization:Strings.OCRWindow_Single_line}"
                              IsChecked="{Binding SingleLine}"
                              FontWeight="Normal"/>
                    <CheckBox Grid.Column="1"
                              Content="{x:Static localization:Strings.OCRWindow_Copy_recognized_text_automatically}"
                              IsChecked="{Binding AutoCopy}"
                              FontWeight="Normal"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <ComboBox ItemsSource="{Binding ServiceLinks}"
                                  SelectedItem="{Binding SelectedServiceLink}"
                                  IsEnabled="{Binding HasServices}"
                                  MinWidth="180"
                                  VerticalAlignment="Center"/>
                        <Button Command="{Binding EditServicesCommand}"
                                ToolTip.Tip="{x:Static localization:Strings.OCRWindow_Edit_services}"
                                Padding="10,7">
                            <controls:IconPresenter Icon="{x:Static icons:AppIcons.Settings}"/>
                        </Button>
                        <Button Command="{Binding OpenServiceCommand}" IsEnabled="{Binding CanUseResult}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.ExternalLink}"/>
                                <TextBlock Text="{x:Static localization:Strings.OCRWindow_Open_service}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid IsVisible="{Binding IsEditingServices}"
                  Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Classes="tool-panel"
                        Width="620"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.OCRWindow_Edit_services}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding NewServiceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Plus}"/>
                                        <TextBlock Text="{x:Static localization:Strings.OCRWindow_New}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveServiceCommand}" IsEnabled="{Binding HasEditingService}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Trash}"/>
                                        <TextBlock Text="{x:Static localization:Strings.OCRWindow_Remove}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetServicesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Reset}"/>
                                        <TextBlock Text="{x:Static localization:Strings.OCRWindow_Reset}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding ServiceLinks}"
                                  SelectedItem="{Binding EditingServiceLink}"
                                  PlaceholderText="{x:Static localization:Strings.OCRWindow_Select_a_service}"
                                  HorizontalAlignment="Stretch"/>
                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="75,*" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="row-label" Text="{x:Static localization:Strings.OCRWindow_Name}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding EditingServiceLink.Name, Mode=TwoWay}"
                                     IsEnabled="{Binding HasEditingService}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="row-label" Text="{x:Static localization:Strings.OCRWindow_URL}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding EditingServiceLink.Url, Mode=TwoWay}"
                                     IsEnabled="{Binding HasEditingService}"
                                     PlaceholderText="{x:Static localization:Strings.OCRWindow_Use_0_where_the_recognized_text_belongs}"/>
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                            <CheckBox Content="{x:Static localization:Strings.OCRWindow_Close_after_opening}"
                                      IsChecked="{Binding CloseAfterOpeningService}"
                                      FontWeight="Normal"/>
                            <Button Grid.Column="1"
                                    Content="{x:Static localization:Strings.OCRWindow_Close}"
                                    Command="{Binding CloseServiceEditorCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
</Window>
