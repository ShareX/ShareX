<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="575"
        x:Class="ShareX.Tools.VideoConverterWindow"
        x:DataType="vm:VideoConverterViewModel"
        Title="{x:Static localization:Strings.VideoConverterWindow_ShareX_Video_Converter}"
        Width="850"
        Height="475"
        MinWidth="700"
        MinHeight="475"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.path-text">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
    </Window.Styles>

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
                <Border Grid.Row="0" Classes="tool-panel" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Classes="section-heading"
                                   Text="{x:Static localization:Strings.VideoConverterWindow_Input_file}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Classes="path-text"
                                   Text="{Binding InputFileDisplay}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="{x:Static localization:Strings.VideoConverterWindow_Browse}"
                                Command="{Binding BrowseInputCommand}"
                                IsEnabled="{Binding IsIdle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="360,*"
                      ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="tool-panel" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <StackPanel>
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.VideoConverterWindow_Encoding}"/>
                                    <TextBlock Classes="field-label" Text="{x:Static localization:Strings.VideoConverterWindow_Video_encoder}"/>
                                    <ComboBox ItemsSource="{x:Static vm:VideoConverterViewModel.Codecs}"
                                              SelectedItem="{Binding SelectedCodec}"
                                              IsEnabled="{Binding IsIdle}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoConverterCodecItem">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding ShowsQualityControls}">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.VideoConverterWindow_Quality}"/>
                                    <CheckBox IsChecked="{Binding UseBitrate}"
                                              IsVisible="{Binding CanChooseRateControl}"
                                              IsEnabled="{Binding IsIdle}"
                                              Margin="0,0,0,10">
                                        <TextBlock Text="{x:Static localization:Strings.VideoConverterWindow_Use_a_target_bitrate}" FontWeight="Normal"/>
                                    </CheckBox>

                                    <StackPanel IsVisible="{Binding ShowsQualitySlider}" Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="field-label" Text="{x:Static localization:Strings.VideoConverterWindow_Constant_quality}" Margin="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VideoQuality, StringFormat={}{0:0}}"/>
                                        </Grid>
                                        <Slider Minimum="{Binding QualityMinimum}"
                                                Maximum="{Binding QualityMaximum}"
                                                Value="{Binding VideoQuality}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                IsEnabled="{Binding IsIdle}"/>
                                        <Grid ColumnDefinitions="*,*">
                                            <TextBlock Grid.Column="0" Text="{x:Static localization:Strings.VideoConverterWindow_Higher_quality}" FontSize="12" FontWeight="Normal"/>
                                            <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.VideoConverterWindow_Smaller_file}" FontSize="12" FontWeight="Normal" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding ShowsBitrate}">
                                        <TextBlock Classes="field-label" Text="{x:Static localization:Strings.VideoConverterWindow_Target_bitrate}"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <NumericUpDown Grid.Column="0"
                                                           Minimum="100"
                                                           Maximum="100000"
                                                           Increment="100"
                                                           FormatString="0"
                                                           Value="{Binding VideoBitrate}"
                                                           IsEnabled="{Binding IsIdle}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.VideoConverterWindow_kbps}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Classes="tool-panel" Padding="16">
                            <StackPanel>
                                <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.VideoConverterWindow_Output}"/>
                                <TextBlock Classes="field-label" Text="{x:Static localization:Strings.VideoConverterWindow_Folder}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding OutputFolderPath}"
                                             PlaceholderText="{x:Static localization:Strings.VideoConverterWindow_Choose_an_output_folder}"
                                             IsEnabled="{Binding IsIdle}"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding BrowseOutputFolderCommand}"
                                            IsEnabled="{Binding IsIdle}">
                                        <TextBlock Text="{x:Static theming:LucideIcons.folder_open}"
                                                   Classes="icon"/>
                                    </Button>
                                </Grid>
                                <TextBlock Classes="field-label" Text="{x:Static localization:Strings.VideoConverterWindow_File_name}"/>
                                <TextBox Text="{Binding OutputFileName}"
                                         PlaceholderText="{x:Static localization:Strings.VideoConverterWindow_video_output}"
                                         IsEnabled="{Binding IsIdle}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Classes="path-text"
                                           Text="{Binding OutputFilePath}"
                                           Margin="0,0,0,12"/>
                                <CheckBox IsChecked="{Binding AutoOpenFolder}" IsEnabled="{Binding IsIdle}">
                                    <TextBlock Text="{x:Static localization:Strings.VideoConverterWindow_Open_the_output_folder_when_finished}"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                    </Border>

                </Grid>

                <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                    <ProgressBar Grid.Row="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Height="6"
                                 Margin="0,0,0,8"
                                 IsVisible="{Binding IsEncoding}"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusText}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding StartEncodingCommand}"
                                IsVisible="{Binding IsIdle}"
                                VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static theming:LucideIcons.play}"
                                           Classes="icon"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static localization:Strings.VideoConverterWindow_Start_encoding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding StopEncodingCommand}"
                                IsVisible="{Binding IsEncoding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static theming:LucideIcons.square_stop}"
                                           Classes="icon"/>
                                <TextBlock Text="{x:Static localization:Strings.VideoConverterWindow_Stop_encoding}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
</Window>
