<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.Tools.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        x:Class="ShareX.Tools.DirectoryIndexerWindow"
        x:DataType="vm:DirectoryIndexerViewModel"
        Title="{x:Static localization:Strings.DirectoryIndexerWindow_ShareX_Directory_Indexer}"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Border Grid.Row="0" Classes="tool-panel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Folder}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Classes="path-text"
                                   Text="{Binding FolderPath, TargetNullValue='No folder selected'}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{x:Static localization:Strings.DirectoryIndexerWindow_Browse}" Command="{Binding BrowseFolderCommand}" IsEnabled="{Binding IsIdle}"/>
                        <Button Grid.Column="3" Command="{Binding IndexCommand}" IsEnabled="{Binding CanIndex}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.folder_search}"/>
                                <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Generate_output}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="0,0,10,0">
                            <Border Classes="tool-panel">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Index_options}"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="115,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Output_format}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding SelectedOutput}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IndexerOutputChoice">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Normal"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="115,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Maximum_depth}"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Minimum="0"
                                                       Maximum="1000"
                                                       FormatString="0"
                                                       Value="{Binding MaxDepthLevel}"
                                                       PlaceholderText="{x:Static localization:Strings.DirectoryIndexerWindow_0_is_unlimited}"/>
                                    </Grid>
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Skip_hidden_folders}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipHiddenFolders}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Skip_hidden_files}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipHiddenFiles}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Folders_only}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding FoldersOnly}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="6" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                                            <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Show_sizes}" FontWeight="Normal" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSizeInfo}" OnContent="" OffContent=""/>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" MinHeight="30">
                                            <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Add_generated_by_footer}" FontWeight="Normal" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AddFooter}" OnContent="" OffContent=""/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="tool-panel" IsVisible="{Binding IsText}">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Text_output}"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="115,*" ColumnSpacing="10">
                                        <TextBlock Classes="row-label" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Indentation}"/>
                                        <TextBox Grid.Column="1" Text="{Binding IndentationText}"/>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Empty_line_after_folders}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AddEmptyLineAfterFolders}" OnContent="" OffContent=""/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="tool-panel" IsVisible="{Binding IsHtml}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_HTML_output}"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Display_folder_paths}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DisplayPath}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" MinHeight="30" IsEnabled="{Binding CanLimitDisplayPath}">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Limit_paths_to_root_folder}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DisplayPathLimited}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Use_custom_CSS_file}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomCSSFile}" OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding UseCustomCSSFile}">
                                        <TextBox Text="{Binding CustomCSSFilePath}" PlaceholderText="{x:Static localization:Strings.DirectoryIndexerWindow_Select_a_CSS_file}"/>
                                        <Button Grid.Column="1" Content="{x:Static localization:Strings.DirectoryIndexerWindow_Browse}" Command="{Binding BrowseCSSCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="tool-panel" IsVisible="{Binding IsXml}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_XML_output}"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Write_information_as_attributes}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseAttribute}" OnContent="" OffContent=""/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="tool-panel" IsVisible="{Binding IsJson}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
                                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_JSON_output}"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" MinHeight="30">
                                        <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Create_parseable_structured_JSON}" FontWeight="Normal" VerticalAlignment="Center"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateParseableJson}" OnContent="" OffContent=""/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Classes="tool-panel" Padding="0" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="12">
                                <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.DirectoryIndexerWindow_Generated_output}" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static localization:Strings.DirectoryIndexerWindow_Ready_to_save_or_upload}"
                                           IsVisible="{Binding HasSource}"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                            <Grid Grid.Row="2" Margin="12,0,12,12">
                                <TextBox Text="{Binding Source}"
                                         IsVisible="{Binding CanPreview}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         FontFamily="Consolas"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                <StackPanel IsVisible="{Binding ShowsHtmlPreviewNotice}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="390"
                                            Spacing="10">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.file_code}"
                                               FontSize="44"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_The_HTML_index_was_generated_successfully_HTML_preview_is_unavailable_but_the_output_is_ready_to_save_or_upload}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding !HasSource}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="390"
                                            Spacing="10">
                                    <TextBlock Classes="icon"
                                               Text="{x:Static theming:LucideIcons.folder_tree}"
                                               FontSize="44"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Choose_a_folder_and_generate_output_Nothing_is_saved_until_you_use_Save_as_or_Upload}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding SaveAsCommand}" IsEnabled="{Binding HasSource}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.save}"/>
                            <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Save_as}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding UploadCommand}" IsEnabled="{Binding HasSource}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.upload}"/>
                            <TextBlock Text="{x:Static localization:Strings.DirectoryIndexerWindow_Upload}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
</Window>
