<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:local="using:ShareX.Tools"
        xmlns:loc="using:ShareX.Tools.Localization"
        x:Class="ShareX.Tools.VideoPlayerWindow"
        x:DataType="local:VideoPlayerViewModel"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        Width="960" Height="600" MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="VideoViewport" Classes="video-viewport" Classes.has-video="{Binding HasVideo}">
        <Border.Styles>
            <Style Selector="Border.video-viewport">
                <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
            </Style>
            <Style Selector="Border.video-viewport.has-video">
                <Setter Property="Background" Value="Black"/>
            </Style>
        </Border.Styles>
        <Grid>
            <local:WindowsMediaPlayer x:Name="Player" IsVisible="{Binding HasVideo}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel IsVisible="{Binding !HasVideo}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16" Margin="32,32,32,100" MaxWidth="640">
                <controls:IconPresenter Icon="{x:Static icons:AppIcons.Film}" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="Normal"/>
                <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4" Width="160"/>
            </StackPanel>

            <!-- A native popup can draw above the child HWND used by Media Foundation. -->
            <Popup x:Name="ControlsPopup" PlacementTarget="{Binding #VideoViewport}"
                   Placement="AnchorAndGravity" PlacementAnchor="Bottom" PlacementGravity="Top"
                   PlacementConstraintAdjustment="None"
                   ShouldUseOverlayLayer="False" IsLightDismissEnabled="False" Topmost="False">
                <Border x:Name="PlaybackControls" Background="#80000000" CornerRadius="6" Padding="8,4">
                    <Border.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Style>
                        <Style Selector="Button.player-button">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="Button.player-button /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="Button.player-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#30FFFFFF"/>
                        </Style>
                        <Style Selector="Button.player-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#55FFFFFF"/>
                        </Style>
                        <Style Selector="Button.player-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Opacity" Value="0.35"/>
                        </Style>
                    </Border.Styles>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="2">
                            <Button x:Name="OpenButton" Classes="player-button" Command="{Binding BrowseCommand}"
                                    ToolTip.Tip="{x:Static loc:Strings.VideoTrimmer_Open}"
                                    AutomationProperties.Name="{x:Static loc:Strings.VideoTrimmer_Open}">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.FolderOpen}"/>
                            </Button>
                            <Button Grid.Column="1" Classes="player-button" Command="{Binding StepBackwardCommand}" IsEnabled="{Binding HasVideo}"
                                    ToolTip.Tip="{x:Static loc:Strings.AnimatedGifTrimmer_PreviousFrame}"
                                    AutomationProperties.Name="{x:Static loc:Strings.AnimatedGifTrimmer_PreviousFrame}">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.StepBack}"/>
                            </Button>
                            <Button x:Name="PlayButton" Grid.Column="2" Classes="player-button" Command="{Binding TogglePlayCommand}" IsEnabled="{Binding HasVideo}"
                                    ToolTip.Tip="{Binding PlayActionText}" AutomationProperties.Name="{Binding PlayActionText}">
                                <Grid>
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Play}" IsVisible="{Binding !IsPlaying}"/>
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Pause}" IsVisible="{Binding IsPlaying}"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="3" Classes="player-button" Command="{Binding StepForwardCommand}" IsEnabled="{Binding HasVideo}"
                                    ToolTip.Tip="{x:Static loc:Strings.AnimatedGifTrimmer_NextFrame}"
                                    AutomationProperties.Name="{x:Static loc:Strings.AnimatedGifTrimmer_NextFrame}">
                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.StepForward}"/>
                            </Button>
                            <TextBlock Grid.Column="4" Text="{Binding TimeText}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0"/>
                            <Button Grid.Column="5" Classes="player-button" Command="{Binding ToggleMuteCommand}"
                                    ToolTip.Tip="{Binding MuteActionText}" AutomationProperties.Name="{Binding MuteActionText}">
                                <Grid>
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Volume}" IsVisible="{Binding !SoundOff}"/>
                                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Mute}" IsVisible="{Binding SoundOff}"/>
                                </Grid>
                            </Button>
                            <Slider Grid.Column="6" Width="60" Height="36" MinHeight="36" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                    VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.VideoPlayer_Volume}"
                                    AutomationProperties.Name="{x:Static loc:Strings.VideoPlayer_Volume}">
                                <Slider.Resources>
                                    <GridLength x:Key="SliderPreContentMargin">*</GridLength>
                                    <GridLength x:Key="SliderPostContentMargin">*</GridLength>
                                </Slider.Resources>
                            </Slider>
                            <Button x:Name="FullscreenButton" Grid.Column="7" Classes="player-button" Click="OnFullscreenClick"
                                    ToolTip.Tip="{x:Static loc:Strings.VideoPlayer_Fullscreen}"
                                    AutomationProperties.Name="{x:Static loc:Strings.VideoPlayer_Fullscreen}">
                                <controls:IconPresenter x:Name="FullscreenIcon" Icon="{x:Static icons:AppIcons.Expand}"/>
                            </Button>
                        </Grid>
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding Duration}"
                                Value="{Binding Position, Mode=TwoWay}" IsEnabled="{Binding HasVideo}" Height="30" MinHeight="30" Padding="5,0"
                                AutomationProperties.Name="{x:Static loc:Strings.VideoPlayer_Seek}">
                            <Slider.Resources>
                                <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
                                <GridLength x:Key="SliderPreContentMargin">*</GridLength>
                                <GridLength x:Key="SliderPostContentMargin">*</GridLength>
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>