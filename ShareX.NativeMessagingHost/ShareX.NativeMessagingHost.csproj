<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ShareX_NativeMessagingHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
    <ProjectReference Include="..\ShareX.Platform.Windows\ShareX.Platform.Windows.csproj" />
    <ProjectReference Include="..\ShareX.Platform.Linux\ShareX.Platform.Linux.csproj" />
    <ProjectReference Include="..\ShareX.Platform.MacOS\ShareX.Platform.MacOS.csproj" />
  </ItemGroup>
  <!-- Build dependencies separately so this plain-net10.0 host cannot overwrite the application's
       Windows SDK platform DLL. ShareX supplies their runtime copies; deploy only the host's own files. -->
  <Target Name="CopyNativeMessagingHostToApplication" AfterTargets="Build">
    <ItemGroup>
      <NativeMessagingHostFiles Include="$(TargetDir)$(AssemblyName)*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeMessagingHostFiles)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\ShareX\bin\$(Configuration)\$(RuntimeIdentifier)\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
