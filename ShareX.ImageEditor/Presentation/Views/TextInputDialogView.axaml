<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShareX.ImageEditor.Presentation.ViewModels"
             xmlns:res="using:ShareX.ImageEditor.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="240"
             x:Class="ShareX.ImageEditor.Presentation.Views.TextInputDialogView"
             x:DataType="vm:TextInputDialogViewModel">

    <Border Background="{DynamicResource ShareX.Brush.Background.Popup}"
            BorderBrush="{DynamicResource ShareX.Brush.Border}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="0"
            Width="400"
            BoxShadow="0 4 10 0 #40000000">
        <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource ShareX.Brush.Background.Panel}">
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <TextBlock Text="{x:Static res:Strings.TextInputDialogView_Title}" FontSize="15" VerticalAlignment="Center"/>
            </Border>

            <!-- Content -->
            <TextBox Grid.Row="1" x:Name="InputBox"
                     Margin="12"
                     Height="120"
                     Text="{Binding Text, Mode=TwoWay}"
                     AcceptsReturn="True"
                     NewLine="&#10;"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"/>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                    <Button Padding="20,0" Content="{x:Static res:Strings.TextInputDialogView_OK}" Command="{Binding OkCommand}" HorizontalContentAlignment="Center"/>
                    <Button Padding="20,0" Content="{x:Static res:Strings.TextInputDialogView_Cancel}" Command="{Binding CancelCommand}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
