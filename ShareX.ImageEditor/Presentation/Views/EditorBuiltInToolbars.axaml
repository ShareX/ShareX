<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconControls="using:ShareX.AvaloniaUI.Controls"
             xmlns:res="using:ShareX.ImageEditor.Localization"
             xmlns:vm="using:ShareX.ImageEditor.Presentation.ViewModels"
             xmlns:editorTheming="using:ShareX.ImageEditor.Presentation.Theming"
             xmlns:controls="using:ShareX.ImageEditor.Presentation.Controls"
             x:Class="ShareX.ImageEditor.Presentation.Views.EditorBuiltInToolbars"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border.toolbar-drag-handle">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.toolbar-drag-handle > Path">
            <Setter Property="Fill" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>

        <Style Selector="Border.toolbar-drag-handle:pointerover > Path">
            <Setter Property="Fill" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>

        <!-- Bottom toolbar sizes; the compact class shrinks them to match the compact top toolbar. -->
        <Style Selector="Border#BottomToolbarHost">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>

            <Style Selector="^ StackPanel.bottom-toolbar-row">
                <Setter Property="Spacing" Value="4"/>
            </Style>

            <Style Selector="^ controls|ZoomPickerDropdown">
                <Setter Property="Height" Value="40"/>
            </Style>

            <Style Selector="^ Border.bottom-toolbar-separator">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>

            <Style Selector="^ Grid.task-buttons">
                <Setter Property="Width" Value="90"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="4,0,10,0"/>
            </Style>

            <Style Selector="^ Button.cancel-task">
                <Setter Property="Width" Value="55"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="27,0,10,0"/>
                <Setter Property="CornerRadius" Value="0,4,4,0"/>
            </Style>

            <Style Selector="^ Button.continue-task">
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="CornerRadius" Value="28"/>
                <Setter Property="Margin" Value="0,0,0,-8"/>
            </Style>

            <Style Selector="^ Button.continue-task > iconControls|IconPresenter">
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <Style Selector="^ Button.bottom-toolbar-button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style Selector="^ iconControls|IconPresenter.bottom-toolbar-icon">
                <Setter Property="FontSize" Value="20"/>
            </Style>
        </Style>

        <Style Selector="Border#BottomToolbarHost.compact">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>

            <Style Selector="^ StackPanel.bottom-toolbar-row">
                <Setter Property="Spacing" Value="1"/>
            </Style>

            <Style Selector="^ controls|ZoomPickerDropdown">
                <Setter Property="Height" Value="28"/>
                <Setter Property="IsCompact" Value="True"/>
            </Style>

            <Style Selector="^ Border.bottom-toolbar-separator">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="2,0"/>
            </Style>

            <Style Selector="^ Grid.task-buttons">
                <Setter Property="Width" Value="62"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="2,0,4,0"/>
            </Style>

            <Style Selector="^ Button.cancel-task">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="18,0,6,0"/>
                <Setter Property="CornerRadius" Value="0,3,3,0"/>
            </Style>

            <Style Selector="^ Button.continue-task">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,-2"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style Selector="^ Button.continue-task > iconControls|IconPresenter">
                <Setter Property="Margin" Value="2,0,0,0"/>
            </Style>

            <Style Selector="^ Button.bottom-toolbar-button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="MinWidth" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>

            <Style Selector="^ iconControls|IconPresenter.bottom-toolbar-icon">
                <Setter Property="FontSize" Value="16"/>
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border x:Name="TopToolbarHost"
                Classes="editor-toolbar-host top"
                Classes.hidden="{Binding AreToolbarsHidden}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                ZIndex="1"
                IsHitTestVisible="{Binding ShowToolbars}">
            <!-- The hide animation uses the host's RenderTransform, so a drag moves the toolbar inside it instead. -->
            <controls:AnnotationToolbar x:Name="AnnotationToolbarControl"
                                        DataContext="{Binding ToolbarAdapter}"
                                        ShowEditingActions="False"
                                        MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <controls:AnnotationToolbar.MainToolbarLeadingContent>
                    <Border x:Name="TopToolbarDragHandle"
                            Classes="toolbar-drag-handle"
                            Cursor="SizeAll"
                            PointerPressed="OnTopToolbarDragHandlePointerPressed"
                            PointerMoved="OnTopToolbarDragHandlePointerMoved"
                            PointerReleased="OnTopToolbarDragHandlePointerReleased"
                            PointerCaptureLost="OnTopToolbarDragHandlePointerCaptureLost"
                            ToolTip.Tip="{x:Static res:Strings.EditorBuiltInToolbars_MoveToolbar}"
                            AutomationProperties.Name="{x:Static res:Strings.EditorBuiltInToolbars_MoveToolbar}">
                        <Path Data="M0,0h2v2h-2z M4,0h2v2h-2z M0,4h2v2h-2z M4,4h2v2h-2z M0,8h2v2h-2z M4,8h2v2h-2z M0,12h2v2h-2z M4,12h2v2h-2z"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </controls:AnnotationToolbar.MainToolbarLeadingContent>
            </controls:AnnotationToolbar>
        </Border>

        <Border x:Name="BottomToolbarHost"
                Classes="editor-toolbar-host bottom"
                Classes.hidden="{Binding AreToolbarsHidden}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                BorderBrush="{DynamicResource ShareX.Brush.Border}"
                BorderThickness="1"
                MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ClipToBounds="False"
                IsHitTestVisible="{Binding ShowToolbars}">
            <StackPanel Classes="bottom-toolbar-row" Orientation="Horizontal" ClipToBounds="False">
                <controls:ZoomPickerDropdown SelectedZoom="{Binding Zoom}"
                                             ZoomChanged="OnZoomChanged"
                                             ZoomToFitRequested="OnZoomToFitRequested"
                                             ToolTip.Tip="{x:Static res:Strings.EditorView_ZoomCtrlWheel}"
                                             ToolTip.Placement="Top"
                                             ToolTip.VerticalOffset="-5"/>

                <Border Classes="bottom-toolbar-separator"
                        Width="1"
                        Background="{DynamicResource ShareX.Brush.Separator}"
                        IsVisible="{Binding ShowBottomToolbar}"/>

                <Grid Classes="task-buttons"
                      ClipToBounds="False"
                      VerticalAlignment="Bottom"
                      IsVisible="{Binding ShowTaskButtons}">
                    <Button Command="{Binding CancelCommand}"
                            Classes="task-mode-button danger cancel-task"
                            BorderThickness="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{x:Static res:Strings.EditorView_CancelEsc}"
                            ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-5"
                            ZIndex="0">
                        <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionCancel}"
                                                    Classes="bottom-toolbar-icon"
                                                    VerticalAlignment="Center"/>
                    </Button>

                    <Button Command="{Binding ContinueCommand}"
                            Classes="task-mode-button success continue-task"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            ToolTip.Tip="{Binding ContinueButtonTooltip}"
                            ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-5"
                            ZIndex="20">
                        <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionContinue}"
                                                    Classes="bottom-toolbar-icon"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding CopyCommand}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_CopyimagetoclipboardCtrlC}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionCopy}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_SaveimageCtrlS}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionSave}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding SaveAsCommand}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_SaveimageasEllipsisCtrlShiftS}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionSaveAs}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding PinToScreenCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_PinimagetoscreenCtrlP}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionPinToScreen}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding PrintCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_PrintimageEllipsisCtrlShiftP}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionPrint}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>

                <Button Classes="bottom-toolbar-button"
                        Command="{Binding UploadCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_UploadimageCtrlU}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionUpload}"
                                                Classes="bottom-toolbar-icon"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
