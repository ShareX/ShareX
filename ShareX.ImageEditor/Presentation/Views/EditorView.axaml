<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:ShareX.ImageEditor.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShareX.ImageEditor.Presentation.ViewModels"
             xmlns:views="using:ShareX.ImageEditor.Presentation.Views"
             xmlns:models="using:ShareX.ImageEditor.Core.Annotations"
             xmlns:converters="using:ShareX.ImageEditor.Presentation.Converters"
             xmlns:editorTheming="using:ShareX.ImageEditor.Presentation.Theming"
             xmlns:helpers="using:ShareX.ImageEditor.Presentation.Rendering"
             xmlns:controls="using:ShareX.ImageEditor.Presentation.Controls"
             xmlns:iconControls="using:ShareX.AvaloniaUI.Controls"
             xmlns:easterEggs="using:ShareX.ImageEditor.Presentation.EasterEggs"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ShareX.ImageEditor.Presentation.Views.EditorView"
             x:DataType="vm:MainViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}">

    <UserControl.Styles>
        <Style Selector="Button.crop-confirm-button">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Popup}"/>

            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Popup}"/>
            </Style>

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Popup}"/>
            </Style>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ConfirmationDialogViewModel}" x:DataType="vm:ConfirmationDialogViewModel">
            <views:ConfirmationDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewImageDialogViewModel}" x:DataType="vm:NewImageDialogViewModel">
            <views:NewImageDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsertImageDialogViewModel}" x:DataType="vm:InsertImageDialogViewModel">
            <views:InsertImageDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmojiPickerDialogViewModel}" x:DataType="vm:EmojiPickerDialogViewModel">
            <views:EmojiPickerDialogView MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                         MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartScreenDialogViewModel}" x:DataType="vm:StartScreenDialogViewModel">
            <views:StartScreenDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolbarCustomizationDialogViewModel}" x:DataType="vm:ToolbarCustomizationDialogViewModel">
            <views:ToolbarCustomizationDialogView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Resources>
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />

        <ContextMenu x:Key="EditorContextMenu"
                     Placement="Pointer"
                     BorderBrush="{DynamicResource ShareX.Brush.Border}"
                     BorderThickness="1"
                     CornerRadius="6"
                     Padding="6,2"
                     Cursor="Arrow">
            <MenuItem Header="{x:Static res:Strings.EditorView_Undo}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionUndo}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Redo}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionRedo}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{x:Static res:Strings.EditorView_Delete}" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionDelete}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Deleteall}" Command="{Binding ClearAnnotationsCommand}" InputGesture="Shift+Delete">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionClearAll}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Flatten}" Command="{Binding FlattenImageCommand}" InputGesture="Ctrl+Shift+F">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.LayerFlatten}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{x:Static res:Strings.EditorView_Cut}" Command="{Binding CutAnnotationCommand}" InputGesture="Ctrl+X">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionCut}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Copy}" Command="{Binding CopyAnnotationCommand}" InputGesture="Ctrl+Shift+C">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionCopy}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Paste}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionPaste}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Duplicate}" Command="{Binding DuplicateSelectedCommand}" InputGesture="Ctrl+D">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionDuplicate}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{x:Static res:Strings.EditorView_Bringtofront}" Command="{Binding BringToFrontCommand}" InputGesture="Home">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionBringToFront}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Bringforward}" Command="{Binding BringForwardCommand}" InputGesture="PageUp">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionBringForward}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Sendbackward}" Command="{Binding SendBackwardCommand}" InputGesture="PageDown">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionSendBackward}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.EditorView_Sendtoback}" Command="{Binding SendToBackCommand}" InputGesture="End">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionSendToBack}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{Binding ToggleToolbarsMenuHeader}" Command="{Binding ToggleToolbarsCommand}" InputGesture="Ctrl+H">
                <MenuItem.Icon>
                    <iconControls:IconPresenter Icon="{x:Static editorTheming:EditorIcons.ActionToggleToolbars}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid RowDefinitions="*">

        <!-- Row 0: Main Content Area with Preview and Sidebar (Background Layer) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource ShareX.Brush.Background.Main}">

            <!-- Left Sidebar (Settings Panel) -->
            <!-- BackgroundSettingsPanel is created the first time the panel opens -->
            <Border x:Name="BackgroundSettingsSidebar"
                    Grid.Column="0"
                    Classes="editor-sidebar left"
                    Classes.open="{Binding IsSettingsPanelOpen}"
                    Padding="0"
                    Background="{DynamicResource ShareX.Brush.Background.Panel}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    IsHitTestVisible="{Binding IsSettingsPanelOpen}"/>

            <!-- Central Preview Canvas -->
            <Grid x:Name="EditorCanvasHost" Grid.Column="1" Margin="8">
                <ScrollViewer Name="CanvasScrollViewer"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnCanvasScrollChanged"
                              PointerPressed="OnScrollViewerPointerPressed"
                              PointerMoved="OnScrollViewerPointerMoved"
                              PointerReleased="OnScrollViewerPointerReleased">
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding EffectiveZoom}" ScaleY="{Binding EffectiveZoom}" />
                        </LayoutTransformControl.LayoutTransform>
                        <!-- Main Canvas Container with Checkered Background and Shadow -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Checkered Background -->
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                                    Background="{DynamicResource ShareX.Brush.Checkered}"/>

                            <!-- Actual Content -->
                            <Border x:Name="PreviewFrame"
                                    IsVisible="{Binding HasPreviewImage}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Background="{Binding EffectiveCanvasBackground}"
                                     Padding="{Binding CanvasPadding}"
                                     PointerPressed="OnCanvasPointerPressed">
                                <!-- Outer Border: User-controlled Shadow effect -->
                                <Border BoxShadow="{Binding CanvasShadow}"
                                       CornerRadius="{Binding CanvasCornerRadius, Converter={StaticResource DoubleToCornerRadius}}">
                                    <!-- Padding Border: Uses top-left pixel color -->
                                    <Border Background="{Binding SmartPaddingColor}"
                                            Padding="{Binding SmartPaddingThickness}"
                                            CornerRadius="{Binding CanvasCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                            ClipToBounds="True">
                                        <Canvas Background="Transparent"
                                                Width="{Binding SmartPaddingViewportWidth}"
                                                Height="{Binding SmartPaddingViewportHeight}"
                                                ClipToBounds="False">
                                            <!-- Inner Border: Smart padding crops by clipping the viewport,
                                                 while the source image/canvas stay at full size. -->
                                            <Border Background="Transparent"
                                                    Width="{Binding SmartPaddingViewportWidth}"
                                                    Height="{Binding SmartPaddingViewportHeight}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    ClipToBounds="True"
                                                    Canvas.Left="0"
                                                    Canvas.Top="0">
                                                <Canvas Background="Transparent"
                                                        Width="{Binding SmartPaddingViewportWidth}"
                                                        Height="{Binding SmartPaddingViewportHeight}"
                                                        ClipToBounds="True">
                                                    <Grid Name="CanvasContainer"
                                                          Background="Transparent"
                                                          Width="{Binding ImageWidth}"
                                                          Height="{Binding ImageHeight}"
                                                          Canvas.Left="{Binding SmartPaddingOffsetX}"
                                                          Canvas.Top="{Binding SmartPaddingOffsetY}">

                                                        <!-- Image layer (Hybrid Rendering: using SkiaSharp) -->
                                                        <controls:SKCanvasControl Name="CanvasControl"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="Stretch"/>

                                                        <!-- Shared spotlight overlay rendered once for all spotlight annotations -->
                                                        <controls:SpotlightOverlayControl Name="SpotlightOverlayControl"
                                                                         HorizontalAlignment="Stretch"
                                                                         VerticalAlignment="Stretch"
                                                                         IsHitTestVisible="False"
                                                                         IsVisible="False"/>

                                                        <!-- Annotation Layer (Saved content) -->
                                                        <Canvas Name="AnnotationCanvas"
                                                                Background="Transparent"
                                                                IsVisible="{Binding HasPreviewImage}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Cursor="Arrow"
                                                                PointerMoved="OnCanvasPointerMoved"
                                                                PointerReleased="OnCanvasPointerReleased">
                                                        </Canvas>
                                                    </Grid>
                                                </Canvas>
                                            </Border>
                                        </Canvas>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                    </LayoutTransformControl>
                </ScrollViewer>

                <Canvas Name="OverlayHost"
                        ClipToBounds="False"
                        Panel.ZIndex="10">
                    <Canvas Name="OverlayCanvas"
                            Width="0"
                            Height="0"
                            ClipToBounds="False"
                            IsHitTestVisible="True"
                            Cursor="Arrow"
                            PointerPressed="OnCanvasPointerPressed"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerReleased="OnCanvasPointerReleased">
                        <Rectangle Name="CropOverlay"
                                   IsVisible="False"
                                   Stroke="White"
                                   StrokeThickness="2"
                                   StrokeDashArray="4,2"
                                   Fill="#80000000" />
                    </Canvas>
                </Canvas>
            </Grid>

            <!-- Right Sidebar (Effects Panel) -->
            <Border Grid.Column="2"
                    Classes="editor-sidebar right"
                    Classes.open="{Binding IsRightEffectsSidebarVisible}"
                    Padding="0"
                    Background="{DynamicResource ShareX.Brush.Background.Panel}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    IsHitTestVisible="{Binding IsRightEffectsSidebarVisible}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="250" Spacing="0" Margin="16">
                            <ContentControl Content="{Binding EffectsPanelContent}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- The normal editor opts into this lazy host; embedded workspaces leave it empty. -->
        <ContentControl x:Name="BuiltInToolbarsHost" Grid.Row="0"/>

        <Grid x:Name="EditorNotificationHost"
              Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="16,0,16,68"
              ZIndex="28">
            <Border Classes="popup-surface zoom-upward app-toast"
                    Classes.open="{Binding IsNotificationOpen}"
                    MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsVisible="{Binding IsNotificationVisible}"
                    Cursor="Hand"
                    PointerEntered="OnNotificationPointerEntered"
                    PointerExited="OnNotificationPointerExited"
                    PointerPressed="OnNotificationPointerPressed">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <iconControls:IconPresenter Grid.Column="0"
                                                Icon="{Binding NotificationIcon}"
                                                FontSize="18"
                                                Foreground="{DynamicResource ShareX.Brush.Accent}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasNotificationIcon}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding NotificationMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ShareX.Brush.Text}"/>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="InteractionCaptureLayer"
                Grid.Row="0"
                Background="Transparent"
                IsVisible="False"
                IsHitTestVisible="False"
                Cursor="Arrow"
                ZIndex="25"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased"/>

        <!-- Effect Browser Panel Overlay -->
        <Grid Grid.Row="0"
              IsHitTestVisible="{Binding IsEffectBrowserVisible}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ZIndex="30">

            <!-- Click-away background to close the panel -->
            <Grid Classes="overlay-scrim"
                  Classes.open="{Binding IsEffectBrowserVisible}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  PointerPressed="OnEffectBrowserOverlayPointerPressed" />

            <!-- The Panel Itself -->
            <Border Classes="floating-panel"
                    Classes.open="{Binding IsEffectBrowserVisible}"
                    Background="{DynamicResource ShareX.Brush.Background.Panel}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="16,125,16,125"
                    Width="800">

                <ContentControl x:Name="EffectBrowserHost"/>
            </Border>
        </Grid>

        <!-- Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="1"
                Classes="modal-scrim"
                IsVisible="{Binding IsModalOpen}"
                IsHitTestVisible="True">
            <Grid>
                <!-- Click outside to close -->
                <Border Background="Transparent"
                        PointerPressed="OnModalBackgroundPressed"/>

                <!-- Modal Content -->
                <ContentControl x:Name="ModalContentHost"
                                Content="{Binding ModalContent}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Post-process the entire live editor, independently of image zoom and export. -->
        <easterEggs:ShaderEasterEggOverlay x:Name="EasterEggOverlay"
                                          ZIndex="1000"
                                          IsVisible="False"
                                          IsHitTestVisible="False"/>
    </Grid>
</UserControl>
