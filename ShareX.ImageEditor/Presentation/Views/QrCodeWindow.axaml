<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.ImageEditor.Presentation.ViewModels"
        xmlns:theming="using:ShareX.ImageEditor.Presentation.Theming"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="610"
        x:Class="ShareX.ImageEditor.Presentation.Views.QrCodeWindow"
        x:DataType="vm:QrCodeViewModel"
        Title="ShareX - QR Code"
        Width="940"
        Height="610"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.qr-panel">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8"
                          HorizontalAlignment="Left">
                        <Button Grid.Column="0" Command="{Binding ScanScreenCommand}" IsEnabled="{Binding !IsScanning}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static theming:LucideIcons.scan_qr_code}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                <TextBlock Text="Scan screen"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ScanRegionCommand}" IsEnabled="{Binding !IsScanning}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static theming:LucideIcons.scan_line}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                <TextBlock Text="Scan region..."/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ScanImageFileCommand}" IsEnabled="{Binding !IsScanning}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static theming:LucideIcons.file_scan}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                                <TextBlock Text="Scan image..."/>
                            </StackPanel>
                        </Button>
                    </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="430,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="qr-panel" Padding="16">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Classes="section-heading" Text="Content"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding Text}"
                                     PlaceholderText="Enter text or a URL to encode"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MaxLength="2952"/>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,120,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="QR code size"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Minimum="0"
                                               Maximum="2048"
                                               Increment="64"
                                               FormatString="0"
                                               Value="{Binding QrCodeSize}"/>
                                <TextBlock Grid.Column="2"
                                           Text="px"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            x:Name="PreviewHost"
                            Classes="qr-panel"
                            Padding="16"
                            ClipToBounds="True"
                            PointerPressed="OnPreviewPointerPressed">
                        <Grid>
                            <Border Background="White"
                                    CornerRadius="2"
                                    Padding="8"
                                    IsVisible="{Binding HasQrCode}">
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="None"/>
                            </Border>
                            <StackPanel IsVisible="{Binding !HasQrCode}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="{x:Static theming:LucideIcons.qr_code}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                           FontSize="48"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Enter content to generate a QR code"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
                    <Button Grid.Column="0" Command="{Binding CopyImageCommand}" IsEnabled="{Binding HasQrCode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static theming:LucideIcons.copy}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                            <TextBlock Text="Copy image"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding SaveImageCommand}" IsEnabled="{Binding HasQrCode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static theming:LucideIcons.save}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                            <TextBlock Text="Save..."/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding UploadImageCommand}" IsEnabled="{Binding HasQrCode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static theming:LucideIcons.upload}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"/>
                            <TextBlock Text="Upload"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
