<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Portable like the other shared projects: the operating system only through ShareX.Platform. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareX.Avalonia\ShareX.Avalonia.csproj" />
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
    <ProjectReference Include="..\ShareX.ImageEditor\ShareX.ImageEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SkiaSharp" />
    <Using Include="ShareX.PhotoEditor.Core" />
    <Using Include="ShareX.PhotoEditor.Imaging" />
    <Using Include="ShareX.PhotoEditor.Imaging.SelectionMode" Alias="SelectionMode" />
    <Using Include="ShareX.PhotoEditor.Core.GradientStop" Alias="GradientStop" />
    <Using Include="ShareX.PhotoEditor.Core.TextAlignment" Alias="TextAlignment" />
  </ItemGroup>

</Project>
