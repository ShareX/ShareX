<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Offline OCR using PaddleOCR PP-OCRv6 ONNX models</Description>
  </PropertyGroup>
  <!-- As in ShareX.Tools: DirectML in the Windows build, the CPU runtime elsewhere. The CPU runtime has no Intel Mac (osx-x64)
       natives, so PaddleOCREngine.IsAvailable is false there and OCR uses Vision. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
  </ItemGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The models are copied next to the application, where PaddleOCREngine.DefaultModelsFolder looks for them. -->
    <None Include="Models\**\*.onnx;Models\**\*.yml" CopyToOutputDirectory="PreserveNewest" Link="PaddleOCR\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
