<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ShareX.ImageEffectsLib"
        x:Class="ShareX.ImageEffectsLib.ImageEffectPickerWindow"
        Title="ShareX - Add effect"
        Width="520" Height="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource ShareX.Brush.Background.Main}" Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <TextBox x:Name="SearchBox" PlaceholderText="Search effects" TextChanged="OnSearchChanged"/>
            <ListBox x:Name="EffectsList" Grid.Row="1" DoubleTapped="OnEffectDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ImageEffectDefinition">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="10" Margin="4,6">
                            <TextBlock Text="{Binding Category}" FontWeight="Normal" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Normal"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Choose an effect to add after the current selection." FontWeight="Normal"
                           Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Add" Click="OnAddClick"/>
                <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick"/>
            </Grid>
    </Grid>
</Window>
