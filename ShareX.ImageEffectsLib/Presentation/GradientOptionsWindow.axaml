<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.ImageEffectsLib.GradientOptionsWindow"
        Title="ShareX - Gradient"
        Width="400" Height="520" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
        <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Border Width="320" Height="64" HorizontalAlignment="Center"
                    CornerRadius="4" ClipToBounds="True"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="1"
                    Background="{DynamicResource ShareX.Brush.Checkered.Small}">
                <Image x:Name="GradientPreview" Stretch="Fill"/>
            </Border>
            <Border Grid.Row="1" Classes="tool-panel">
                <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                    <TextBlock Classes="row-label" Text="Direction"/>
                    <ComboBox x:Name="DirectionComboBox" Grid.Column="1" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="tool-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section-heading" Text="Color stops"/>
                        <Button Grid.Column="1" Content="Add stop" Click="OnAddStopClick"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="StopsPanel" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,88,88" ColumnSpacing="8">
                <Button Grid.Column="1" Width="88" Content="OK" Click="OnOkClick"/>
                <Button Grid.Column="2" Width="88" Content="Cancel" Click="OnCancelClick"/>
            </Grid>
        </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
