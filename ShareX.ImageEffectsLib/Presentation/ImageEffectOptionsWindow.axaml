<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.ImageEffectsLib.ImageEffectOptionsWindow"
        Title="ShareX - Effect options"
        Width="620" Height="680" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}" RowDefinitions="*,Auto">
            <Border Margin="16,16,16,12" Classes="tool-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock x:Name="EffectTitle" Classes="section-heading"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorPanel" Spacing="8" Margin="0,4,12,4"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16,0,16,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="ValidationText" FontWeight="Normal"
                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Save" Click="OnSaveClick"/>
                <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick"/>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
