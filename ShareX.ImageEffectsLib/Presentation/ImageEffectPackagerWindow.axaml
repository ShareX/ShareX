<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.ImageEffectsLib.Localization"
        x:Class="ShareX.ImageEffectsLib.ImageEffectPackagerWindow"
        Title="{x:Static localization:Strings.ImageEffectPackagerWindow_Title}"
        Width="680" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <Border Classes="tool-panel">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="section-heading" Text="{x:Static localization:Strings.ImageEffectPackagerWindow_Package_preset}"/>
                    <Grid Grid.Row="1" ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="row-label" Text="{x:Static localization:Strings.ImageEffectPackagerWindow_Assets_folder}"/>
                        <TextBox x:Name="AssetsFolderTextBox" Grid.Column="1"/>
                        <Button Grid.Column="2" Content="{x:Static localization:Strings.ImageEffectPackagerWindow_Browse}" Click="OnBrowseAssetsClick"/>
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="row-label" Text="{x:Static localization:Strings.ImageEffectPackagerWindow_Package_file}"/>
                        <TextBox x:Name="PackageFileTextBox" Grid.Column="1"/>
                        <Button Grid.Column="2" Content="{x:Static localization:Strings.ImageEffectPackagerWindow_Browse}" Click="OnBrowsePackageClick"/>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" MinHeight="30">
                        <TextBlock Text="{x:Static localization:Strings.ImageEffectPackagerWindow_Overwrite_existing}" FontWeight="Normal" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="OverwriteToggle" Grid.Column="1" OnContent="" OffContent=""/>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="1" FontWeight="Normal" TextWrapping="Wrap"
                       Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"/>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Button Content="{x:Static localization:Strings.ImageEffectPackagerWindow_Open_effects_folder}" Click="OnOpenFolderClick"/>
                <Button Grid.Column="1" Content="{x:Static localization:Strings.ImageEffectPackagerWindow_Create_package}" Click="OnPackageClick"/>
                <Button Grid.Column="2" Content="{x:Static localization:Strings.ImageEffectPackagerWindow_Close}" Click="OnCloseClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
