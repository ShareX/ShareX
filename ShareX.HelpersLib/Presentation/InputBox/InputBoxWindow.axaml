<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShareX.HelpersLib.InputBoxWindow"
        Width="520"
        Height="120"
        MinWidth="384"
        MaxWidth="1000"
        MinHeight="120"
        MaxHeight="120"
        CanResize="True"
        CanMaximize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.compact">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="12"
              Margin="16"
              Background="{DynamicResource ShareX.Brush.Background.Main}">
            <TextBox x:Name="InputTextBox"
                     MinHeight="36"
                     VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Right">
                <Button x:Name="OKButton"
                        Classes="compact primary"
                        IsDefault="True"
                        Click="OnOKClick"/>
                <Button x:Name="CancelButton"
                        Classes="compact"
                        IsCancel="True"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </ThemeVariantScope>
</Window>
