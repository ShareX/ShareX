<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.UploadersLib.Localization"
        x:Class="ShareX.UploadersLib.EmailWindow"
        Title="{x:Static localization:Strings.EmailWindow_ShareX_Send_email}"
        Width="620"
        Height="480"
        MinWidth="480"
        MinHeight="360"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid RowDefinitions="*,Auto"
              RowSpacing="12"
              Margin="16"
              Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Border Classes="section-card">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="field-label" Text="{x:Static localization:Strings.EmailWindow_To_email}"/>
                        <TextBox x:Name="ToEmailTextBox"
                                 PlaceholderText="{x:Static localization:Strings.EmailWindow_name_example_com}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="field-label" Text="{x:Static localization:Strings.EmailWindow_Subject}"/>
                        <TextBox x:Name="SubjectTextBox"
                                 PlaceholderText="{x:Static localization:Strings.EmailWindow_Email_subject}"/>
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <TextBlock Classes="field-label" Text="{x:Static localization:Strings.EmailWindow_Message}"/>
                        <TextBox x:Name="MessageTextBox"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="9"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Right">
                <Button Classes="compact primary"
                        Content="{x:Static localization:Strings.EmailWindow_Send}"
                        IsDefault="True"
                        Click="OnSendClick"/>
                <Button Classes="compact"
                        Content="{x:Static localization:Strings.EmailWindow_Cancel}"
                        IsCancel="True"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </ThemeVariantScope>
</Window>
