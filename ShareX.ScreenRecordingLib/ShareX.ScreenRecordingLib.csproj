<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Windows-native GPU screen recording and WASAPI audio capture</Description>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Camera layout enums and capture devices are shared models of the platform layer. -->
    <Using Include="ShareX.Platform" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.MediaFoundation" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Used only by ShareX.Platform.Windows; the rest of ShareX reaches it through INativeScreenRecorderService. -->
    <ProjectReference Include="..\ShareX.Platform\ShareX.Platform.csproj" />
    <!-- The adaptive GIF writer uses ShareX's GIF encoder. -->
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
  </ItemGroup>
</Project>
