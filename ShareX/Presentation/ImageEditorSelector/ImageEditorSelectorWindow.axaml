<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.ImageEditorSelectorWindow"
        x:CompileBindings="False"
        Title="ShareX - Image editor selector"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.editor-choice">
            <Setter Property="Height" Value="104"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.editor-choice /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.editor-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.editor-choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.choice-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>
        <Style Selector="TextBlock.choice-description">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.choice-badge">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto">
        <Border Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                Padding="18,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="40"
                        Height="40"
                        CornerRadius="6"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}">
                    <TextBlock Classes="icon"
                               Text="{x:Static theming:LucideIcons.image}"
                               FontSize="20"
                               Foreground="{DynamicResource ShareX.Brush.Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="Choose an image editor"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShareX.Brush.Accent}"/>
                    <TextBlock Text="Select which editor ShareX should open."
                               FontWeight="Normal"
                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Margin="18,14,18,12">
            <Button Classes="editor-choice"
                    IsDefault="True"
                    Click="OnModernImageEditorClick">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                    <TextBlock Classes="icon"
                               Text="{x:Static theming:LucideIcons.wand_sparkles}"
                               FontSize="24"
                               Foreground="{DynamicResource ShareX.Brush.Accent}"
                               VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="choice-title"
                                   Text="Modern image editor"/>
                        <TextBlock Classes="choice-badge"
                                   Text="Recommended"/>
                        <TextBlock Classes="choice-description"
                                   Text="The current ShareX editor with the latest tools and improvements."/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="1"
                    Classes="editor-choice"
                    Click="OnLegacyImageEditorClick">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                    <TextBlock Classes="icon"
                               Text="{x:Static theming:LucideIcons.paintbrush}"
                               FontSize="24"
                               Foreground="{DynamicResource ShareX.Brush.Accent}"
                               VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="choice-title"
                                   Text="Legacy image editor"/>
                        <TextBlock Classes="choice-description"
                                   Text="The classic ShareX region-capture editor."/>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Margin="18,0,18,16"
                Padding="10,8"
                Background="{DynamicResource ShareX.Brush.Background.Panel}"
                CornerRadius="5">
            <TextBlock Text="You can change this later in Task settings → Tools."
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
