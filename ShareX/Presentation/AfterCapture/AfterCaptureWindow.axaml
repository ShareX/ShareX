<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:local="using:ShareX"
        xmlns:res="using:ShareX.Localization"
        x:Class="ShareX.AfterCaptureWindow"
        x:CompileBindings="False"
        Title="{x:Static res:Strings.AfterCaptureWindow_Title}"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="540"
        Topmost="True"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.panel-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="CheckBox.task-option">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
        </Style>
        <Style Selector="TextBlock.section-caption">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="RadioButton.goal-option">
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                Padding="18,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="40"
                        Height="40"
                        CornerRadius="6"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}">
                    <controls:IconPresenter Icon="{x:Static icons:AppIcons.Image}"
                                            FontSize="20"
                                            Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.AfterCaptureWindow_Heading}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                    <TextBlock Text="{x:Static res:Strings.AfterCaptureWindow_Subtitle}"
                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="390,*"
              ColumnSpacing="14"
              Margin="18,14,18,18">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
                <Border Classes="panel-card" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="8,6">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section-title" Text="{x:Static res:Strings.AfterCaptureWindow_GoalHeading}"/>
                                <TextBlock Classes="section-caption" Text="{x:Static res:Strings.AfterCaptureWindow_GoalDescription}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding GoalOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:AfterCaptureGoalOption">
                                        <RadioButton Classes="goal-option"
                                                     GroupName="AfterCaptureGoal"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Label}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Classes="section-caption" Text="{Binding Description}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="RequiredPanel" Spacing="2">
                                <TextBlock Classes="section-title" Text="{x:Static res:Strings.AfterCaptureWindow_RequiredHeading}"/>
                                <ItemsControl ItemsSource="{Binding RequiredOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String">
                                            <CheckBox Classes="task-option"
                                                      Content="{Binding}"
                                                      IsChecked="True"
                                                      IsEnabled="False"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="DestinationPanel" Spacing="4">
                                <TextBlock Classes="section-title" Text="{x:Static res:Strings.AfterCaptureWindow_Destinations}"/>
                                <ComboBox ItemsSource="{Binding DestinationOptions}"
                                          SelectedItem="{Binding SelectedDestination, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{x:Static res:Strings.AfterCaptureWindow_Destinations}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="local:AfterCaptureDestinationOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Classes="section-title" Text="{x:Static res:Strings.AfterCaptureWindow_AlsoHeading}"/>
                                <ItemsControl ItemsSource="{Binding AfterCaptureOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:AfterCaptureTaskOption">
                                            <CheckBox Classes="task-option"
                                                      Content="{Binding Label}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      ToolTip.Tip="{Binding SupportReason}"
                                                      ToolTip.ShowOnDisabled="True"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsVisible="{Binding IsAvailable}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="AfterUploadPanel" Spacing="2">
                                <TextBlock Classes="section-title" Text="{x:Static res:Strings.AfterCaptureWindow_AfterUpload}"/>
                                <ItemsControl ItemsSource="{Binding AfterUploadOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:AfterCaptureTaskOption">
                                            <CheckBox Classes="task-option"
                                                      Content="{Binding Label}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Text="{x:Static res:Strings.AfterCaptureWindow_FileName}" FontWeight="SemiBold"/>
                    <TextBox x:Name="FileNameTextBox"
                             Grid.Row="1"
                             MinHeight="32"
                             Padding="8,5"/>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                    <Button x:Name="CopyButton"
                            Classes="compact icon-button"
                            ToolTip.Tip="{x:Static res:Strings.AfterCaptureWindow_CopyImage}"
                            Click="OnCopyClick">
                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.Copy}"
                                                FontSize="15"/>
                    </Button>
                    <Button Grid.Column="2"
                            Classes="compact primary"
                            Content="{x:Static res:Strings.AfterCaptureWindow_Continue}"
                            IsDefault="True"
                            Click="OnContinueClick"/>
                    <Button Grid.Column="3"
                            Classes="compact"
                            Content="{x:Static res:Strings.AfterCaptureWindow_Cancel}"
                            IsCancel="True"
                            Click="OnCancelClick"/>
                </Grid>
            </Grid>

            <Border x:Name="PreviewSurface"
                    Grid.Column="1"
                    Classes="panel-card checkered-surface"
                    Cursor="Hand"
                    ClipToBounds="True"
                    PointerPressed="OnPreviewPointerPressed">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Margin="10"
                           Stretch="Uniform">
                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static res:Strings.AfterCaptureWindow_CopyPreviewImage}" Click="OnCopyPreviewClick"/>
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>

                    <StackPanel x:Name="EmptyPreview"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <controls:IconPresenter Icon="{x:Static icons:AppIcons.FileVideo}"
                                                FontSize="48"
                                                Opacity="0.45"
                                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyPreviewText"
                                   MaxWidth="360"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
                    </StackPanel>

                    <Border x:Name="ImageSizeBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            Padding="7,3"
                            CornerRadius="4"
                            Background="#CC202020">
                        <TextBlock x:Name="ImageSizeText" Foreground="White" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
