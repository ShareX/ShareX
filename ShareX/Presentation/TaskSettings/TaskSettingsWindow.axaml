<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        x:Class="ShareX.TaskSettingsWindow"
        x:DataType="local:TaskSettingsViewModel"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Grid.page-title">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="TextBlock.page-title-text">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.page-title-icon">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,1,0,3"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.override-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="CheckBox.setting">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="ComboBox.form-control">
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBox.form-control">
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="NumericUpDown.form-control">
            <Setter Property="Width" Value="130"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="ListBox.settings-list">
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBox.action-list > ListBoxItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Grid.action-list-item">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="6,1"/>
        </Style>
        <Style Selector="Grid.action-list-item TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="CheckBox.action-list-toggle">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.action-list-path">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="TextBlock.action-editor-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid ColumnDefinitions="220,*">
                <Border Grid.Column="0"
                        Padding="8"
                        Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <controls:SettingsNavigation x:Name="Navigation"
                                                 Items="{Binding NavigationItems}"
                                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                                 SearchRoot="{Binding #SettingsPages}"/>
                </Border>

                <Grid x:Name="SettingsPages" Grid.Column="1"/>
            </Grid>

            <Border x:Name="ActionEditorOverlay"
                    ZIndex="100"
                    IsVisible="False"
                    Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Width="640"
                        MaxHeight="590"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.zap}"
                                       FontSize="21"
                                       Foreground="{DynamicResource ShareX.Brush.Accent}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock x:Name="ActionEditorTitle"
                                           Text="Add action"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Run an external program as part of a capture workflow."
                                           Classes="hint"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="icon-button"
                                    ToolTip.Tip="Close"
                                    Click="OnCancelActionEditorClick">
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.x}"
                                           FontSize="16"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,0,4,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label" Text="Name"/>
                                    <TextBox x:Name="ActionNameBox" Classes="form-control"/>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label" Text="File path"/>
                                    <Grid ColumnDefinitions="*,32" ColumnSpacing="6">
                                        <TextBox x:Name="ActionPathBox" Classes="form-control"/>
                                        <Button Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTip.Tip="Browse..."
                                                Click="OnBrowseActionPathClick">
                                            <TextBlock Classes="icon"
                                                       Text="{x:Static theming:LucideIcons.folder}"
                                                       FontSize="15"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label" Text="Arguments"/>
                                    <TextBox x:Name="ActionArgumentsBox" Classes="form-control"/>
                                    <TextBlock Classes="hint" Text="Right-click to insert an input or output file token."/>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label"
                                               Text="Output file name extension (empty uses the same file name)"/>
                                    <TextBox x:Name="ActionOutputExtensionBox"
                                             Classes="form-control"
                                             TextChanged="OnActionOutputExtensionTextChanged"/>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label"
                                               Text="Extension filter (example: jpg png mp4)"/>
                                    <TextBox x:Name="ActionExtensionsBox" Classes="form-control"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <CheckBox x:Name="ActionHiddenWindowCheckBox"
                                              Classes="setting"
                                              Content="Hidden window"/>
                                    <CheckBox x:Name="ActionDeleteInputFileCheckBox"
                                              Classes="setting"
                                              Content="Delete input file"/>
                                </StackPanel>

                                <TextBlock x:Name="ActionEditorErrorText"
                                           IsVisible="False"
                                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Cancel.Border}"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="Save"
                                    Click="OnSaveActionEditorClick"/>
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="Cancel"
                                    Click="OnCancelActionEditorClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <Border x:Name="WatchFolderEditorOverlay"
                    ZIndex="100"
                    IsVisible="False"
                    Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Width="600"
                        MaxHeight="480"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                        BorderBrush="{DynamicResource ShareX.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.folder_search}"
                                       FontSize="21"
                                       Foreground="{DynamicResource ShareX.Brush.Accent}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock x:Name="WatchFolderEditorTitle"
                                           Text="Add watch folder"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Upload files when they are created in this folder."
                                           Classes="hint"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,0,4,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label" Text="Folder path"/>
                                    <Grid ColumnDefinitions="*,32" ColumnSpacing="6">
                                        <TextBox x:Name="WatchFolderPathBox" Classes="form-control"/>
                                        <Button Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTip.Tip="Browse..."
                                                Click="OnBrowseWatchFolderClick">
                                            <TextBlock Classes="icon"
                                                       Text="{x:Static theming:LucideIcons.folder}"
                                                       FontSize="15"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Classes="action-editor-label" Text="Filter"/>
                                    <TextBox x:Name="WatchFolderFilterBox" Classes="form-control"/>
                                    <TextBlock Classes="hint" Text="Example: *.png"/>
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <CheckBox x:Name="WatchFolderIncludeSubdirectoriesCheckBox"
                                              Classes="setting"
                                              Content="Include subdirectories"/>
                                    <CheckBox x:Name="WatchFolderMoveToScreenshotsCheckBox"
                                              Classes="setting"
                                              Content="Move file to screenshots folder"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="Save"
                                    Click="OnSaveWatchFolderEditorClick"/>
                            <Button Classes="compact"
                                    MinWidth="84"
                                    Content="Cancel"
                                    Click="OnCancelWatchFolderEditorClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </ThemeVariantScope>
</Window>
