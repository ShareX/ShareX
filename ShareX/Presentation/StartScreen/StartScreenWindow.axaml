<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:ShareX.Icons"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX"
        xmlns:imageEditorControls="using:ShareX.ImageEditor.Presentation.Controls"
        mc:Ignorable="d"
        d:DesignWidth="540"
        x:Class="ShareX.StartScreenWindow"
        x:DataType="local:StartScreenViewModel"
        Title="{Binding WindowTitle}"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.group-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="Margin" Value="1,12,0,12"/>
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="ColumnSpacing" Value="12"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="Width" Value="230"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <StackPanel>
            <StackPanel Margin="20,0,20,20">
                <StackPanel>
                    <TextBlock Classes="group-title" Text="{Binding GeneralGroupTitle}"/>
                    <Border Classes="group">
                        <StackPanel Spacing="12">
                            <Grid Classes="row" ColumnDefinitions="160,*">
                                <TextBlock Classes="label" Text="{Binding LanguageLabel}"/>
                                <ComboBox Grid.Column="1"
                                          Classes="field"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartScreenLanguageOption">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Grid Width="16" Height="16">
                                                    <controls:IconPresenter Icon="{Binding IconGlyph}"
                                                                            FontSize="16"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                    <Border Width="16" Height="12" CornerRadius="2" ClipToBounds="True"
                                                            IsVisible="{Binding Flag, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <Panel>
                                                            <Image Source="{Binding Flag}" Stretch="Fill"/>
                                                            <Border BorderBrush="#26000000" BorderThickness="1" CornerRadius="2"/>
                                                        </Panel>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="160,*">
                                <CheckBox Grid.Column="1"
                                          Content="{Binding StartWithWindowsText}"
                                          IsEnabled="{Binding StartWithWindowsEnabled}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="group-title" Text="{Binding AppearanceGroupTitle}"/>
                    <Border Classes="group">
                        <StackPanel Spacing="12">
                            <Grid Classes="row" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBlock Classes="label" Text="{Binding ThemeLabel}"/>
                                <ComboBox Grid.Column="1"
                                          Classes="field"
                                          IsEnabled="{Binding CanEditTheme}"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartScreenThemeOption">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          Content="{Binding FollowSystemThemeLabel}"
                                          IsChecked="{Binding UseSystemTheme, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <TextBlock Classes="label" Text="{Binding AccentColorLabel}"/>
                                <imageEditorControls:ColorPickerDropdown Grid.Column="1"
                                                                         Width="72"
                                                                         HorizontalAlignment="Left"
                                                                         VerticalAlignment="Center"
                                                                         IsEnabled="{Binding CanEditAccentColor}"
                                                                         SelectedColorValue="{Binding AccentColor, Mode=TwoWay}"/>
                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          Content="{Binding FollowSystemAccentColorLabel}"
                                          IsChecked="{Binding UseSystemAccentColor, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="160,*">
                                <TextBlock Classes="label" Text="{Binding IconPackLabel}"/>
                                <ComboBox Grid.Column="1"
                                          Classes="field"
                                          ItemsSource="{Binding IconPackOptions}"
                                          SelectedItem="{Binding SelectedIconPack, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartScreenIconPackOption">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="5"
                                                        icons:IconPackScope.Pack="{Binding Value}">
                                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.Camera}" FontSize="15" VerticalAlignment="Center"/>
                                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.ScreenRecording}" FontSize="15" VerticalAlignment="Center"/>
                                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.ImageEditor}" FontSize="15" VerticalAlignment="Center"/>
                                                <controls:IconPresenter Icon="{x:Static icons:AppIcons.CloudUpload}" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource ShareX.Brush.Background.Panel}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{Binding SettingsNote}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="primary"
                            MinWidth="110"
                            HorizontalContentAlignment="Center"
                            IsDefault="True"
                            Content="{Binding GetStartedText}"
                            Click="OnGetStartedClick"/>
                </Grid>
            </Border>
        </StackPanel>
    </ThemeVariantScope>
</Window>
