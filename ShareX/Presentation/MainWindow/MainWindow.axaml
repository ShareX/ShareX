<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        xmlns:local="using:ShareX"
        x:Class="ShareX.MainWindow"
        x:CompileBindings="False"
        Title="ShareX"
        Width="1120"
        Height="720"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">

    <Window.Styles>
        <Style Selector="Button.nav-button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.thumbnail-card">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style Selector="Border.thumbnail-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
        </Style>
        <Style Selector="Border.thumbnail-card.selected">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.hotkey-panel">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="210,*" Background="{DynamicResource ShareX.Brush.Background.Main}">
        <Border Grid.Column="0"
                Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                BorderBrush="{DynamicResource ShareX.Brush.Border}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="NavigationPanel"
                            Margin="6,5,6,8"
                            Spacing="0"
                            HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1"
              PointerPressed="OnMainContentPointerPressed"
              PointerReleased="OnMainContentPointerReleased">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ThumbnailItems}" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:ThumbnailItemViewModel">
                                <Border Classes="thumbnail-card"
                                        Classes.selected="{Binding IsSelected}"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        PointerReleased="OnThumbnailPointerReleased"
                                        DoubleTapped="OnThumbnailDoubleTapped"
                                        ToolTip.Tip="{Binding Details}">
                                    <StackPanel Width="{Binding Width}" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding ShowTitleAbove}"
                                                   Foreground="{DynamicResource ShareX.Brush.Text}"
                                                   FontWeight="Normal"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Background="{DynamicResource ShareX.Brush.Background.Panel}"
                                                CornerRadius="4"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       IsVisible="{Binding HasThumbnail}"
                                                       Stretch="Uniform"/>
                                                <TextBlock Classes="icon"
                                                           Text="{Binding PlaceholderIcon}"
                                                           IsVisible="{Binding HasNoThumbnail}"
                                                           FontSize="42"
                                                           Opacity="0.45"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Border IsVisible="{Binding IsFailed}"
                                                        Background="#C8B91C1C"
                                                        CornerRadius="4"
                                                        Padding="6,3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="5">
                                                    <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.triangle_alert}" Foreground="White"/>
                                                </Border>
                                                <ProgressBar IsVisible="{Binding IsProgressVisible}"
                                                             Value="{Binding Progress}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="5"
                                                             VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding ShowTitleBelow}"
                                                   Foreground="{DynamicResource ShareX.Brush.Text}"
                                                   FontWeight="Normal"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Stretch"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid IsVisible="{Binding IsEmpty}" Margin="28">
                    <Border Classes="hotkey-panel"
                            Width="620"
                            MaxHeight="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.keyboard}" FontSize="22" Foreground="{DynamicResource ShareX.Brush.Accent.Start}"/>
                                <TextBlock Text="ShareX hotkeys" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource ShareX.Brush.Text}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="Use a hotkey to capture or upload. Your results will appear here as thumbnails."
                                       TextAlignment="Center"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       Margin="8,0,8,8"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HotkeyTips}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:HotkeyTipViewModel">
                                            <Border BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="0,1,0,0" Padding="6,8">
                                                <Grid ColumnDefinitions="24,155,*" ColumnSpacing="10">
                                                    <TextBlock Classes="icon"
                                                               Text="{x:Static theming:LucideIcons.circle_check}"
                                                               IsVisible="{Binding IsRegistered}"
                                                               Foreground="#3FA75F"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Classes="icon"
                                                               Text="{x:Static theming:LucideIcons.circle_x}"
                                                               IsVisible="{Binding !IsRegistered}"
                                                               Foreground="#C95252"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Hotkey}" FontFamily="{DynamicResource ShareX.FontFamily.Monospace}" FontWeight="Normal"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</Window>
