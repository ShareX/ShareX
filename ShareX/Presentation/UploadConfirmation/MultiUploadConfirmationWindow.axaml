<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:ShareX.Localization"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        x:Class="ShareX.MultiUploadConfirmationWindow"
        Title="{x:Static res:Strings.MultiUploadConfirmationWindow_Title}"
        Width="440"
        MinWidth="360"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource ShareX.Brush.Background.Main}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.message-group">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent.Foreground}"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="12"
              Margin="18"
              Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Border Classes="message-group">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="14"
                      ColumnSpacing="16">
                    <TextBlock Classes="icon"
                               Grid.RowSpan="2"
                               Text="{x:Static theming:LucideIcons.files}"
                               FontSize="32"
                               Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"/>
                    <TextBlock x:Name="MessageText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="Normal"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="DontShowAgainCheckBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              FontWeight="Normal"
                              Content="{x:Static res:Strings.MultiUploadConfirmationWindow_DontShowAgain}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Right">
                <Button Classes="compact primary"
                        Content="{x:Static res:Strings.MultiUploadConfirmationWindow_Upload}"
                        IsDefault="True"
                        Click="OnUploadClick"/>
                <Button Classes="compact"
                        Content="{x:Static res:Strings.MultiUploadConfirmationWindow_Cancel}"
                        IsCancel="True"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </ThemeVariantScope>
</Window>
