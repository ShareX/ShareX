<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX.ScreenCaptureLib"
        xmlns:localization="using:ShareX.ScreenCaptureLib.Localization"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d"
        d:DesignWidth="700"
        d:DesignHeight="420"
        x:Class="ShareX.ScreenCaptureLib.ScreenRecordWindow"
        Title="{x:Static localization:Strings.ScreenRecordWindow_Title}"
        Width="430"
        Height="180"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Button.recorder-action">
            <Setter Property="Width" Value="86"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.recorder-action /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.recorder-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.recorder-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.recorder-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.recorder-action.left-rounded">
            <Setter Property="CornerRadius" Value="7,0,0,7"/>
        </Style>
        <Style Selector="Button.recorder-action.left-rounded /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7,0,0,7"/>
        </Style>
        <Style Selector="Button.recorder-action.left-rounded:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7,0,0,7"/>
        </Style>
        <Style Selector="Button.recorder-action.left-rounded:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7,0,0,7"/>
        </Style>
        <Style Selector="Button.recorder-action.right-rounded">
            <Setter Property="CornerRadius" Value="0,7,7,0"/>
        </Style>
        <Style Selector="Button.recorder-action.right-rounded /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0,7,7,0"/>
        </Style>
        <Style Selector="Button.recorder-action.right-rounded:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0,7,7,0"/>
        </Style>
        <Style Selector="Button.recorder-action.right-rounded:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0,7,7,0"/>
        </Style>
        <Style Selector="TextBlock.action-icon">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.action-label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope>
        <Canvas x:Name="WindowCanvas" Background="Transparent">
            <local:RecordingRegionBorder x:Name="RegionBorder"
                                         Canvas.Left="0"
                                         Canvas.Top="0"
                                         IsHitTestVisible="False"/>

            <Border x:Name="Toolbar"
                    Canvas.Left="0"
                    Width="461"
                    Height="42"
                    Padding="0"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid x:Name="RecorderControls"
                          ColumnDefinitions="112,*">
                        <Border x:Name="TimerDragHandle"
                                Grid.Column="0"
                                CornerRadius="7,0,0,7"
                                Background="{DynamicResource ShareX.Brush.Background.Panel}"
                                Cursor="SizeAll">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border x:Name="StatusIndicator"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="Goldenrod"/>
                                <TextBlock x:Name="TimerText"
                                           Text="00:00:00"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="1">
                            <Button x:Name="StartButton"
                                    Classes="recorder-action left-rounded">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock x:Name="StartIcon"
                                               Classes="icon action-icon"
                                               Text="{x:Static theming:LucideIcons.circle_play}"/>
                                    <TextBlock x:Name="StartText"
                                               Classes="action-label"
                                               Text="{x:Static localization:Strings.ScreenRecordWindow_Start}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="PauseButton"
                                    Classes="recorder-action">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock x:Name="PauseIcon"
                                               Classes="icon action-icon"
                                               Text="{x:Static theming:LucideIcons.pause}"/>
                                    <TextBlock x:Name="PauseText"
                                               Classes="action-label"
                                               Text="{x:Static localization:Strings.ScreenRecordWindow_Pause}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="RestartButton"
                                    Classes="recorder-action"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Classes="icon action-icon"
                                               Text="{x:Static theming:LucideIcons.rotate_ccw}"/>
                                    <TextBlock Classes="action-label"
                                               Text="{x:Static localization:Strings.ScreenRecordWindow_Restart}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="AbortButton"
                                    Classes="recorder-action right-rounded">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Classes="icon action-icon"
                                               Text="{x:Static theming:LucideIcons.x}"/>
                                    <TextBlock Classes="action-label" Text="{x:Static localization:Strings.ScreenRecordWindow_Abort}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AbortConfirmation"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="1"
                          IsVisible="False">
                        <TextBlock Grid.Column="0"
                                   Margin="10,0"
                                   Text="{x:Static localization:Strings.ScreenRecordWindow_Abort_this_recording}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="CancelAbortButton"
                                Grid.Column="1"
                                Classes="recorder-action"
                                Content="{x:Static localization:Strings.ScreenRecordWindow_Cancel}"/>
                        <Button x:Name="ConfirmAbortButton"
                                Grid.Column="2"
                                Classes="recorder-action right-rounded"
                                Content="{x:Static localization:Strings.ScreenRecordWindow_Abort}"/>
                    </Grid>
                </Grid>
            </Border>
        </Canvas>
    </ThemeVariantScope>
</Window>
