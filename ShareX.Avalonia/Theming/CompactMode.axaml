<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Merged into the application resources by ThemeManager while compact mode is on.
        Brings the main window and its menus closer to the ShareX 21 spacing.
    -->
    <x:Double x:Key="ShareX.Density.Nav.MinWidth">180</x:Double>
    <Thickness x:Key="ShareX.Density.Nav.PanelMargin">4,4,4,0</Thickness>
    <x:Double x:Key="ShareX.Density.Nav.ButtonHeight">24</x:Double>
    <Thickness x:Key="ShareX.Density.Nav.ButtonPadding">6,0</Thickness>
    <Thickness x:Key="ShareX.Density.Nav.LabelMargin">5,0,0,0</Thickness>
    <Thickness x:Key="ShareX.Density.Menu.Padding">2</Thickness>
    <x:Double x:Key="ShareX.Density.Menu.ItemHeight">22</x:Double>
    <Thickness x:Key="ShareX.Density.Menu.ItemPadding">5,0</Thickness>
    <Thickness x:Key="ShareX.Density.Menu.SeparatorMargin">4,2</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.Padding">6</Thickness>
    <x:Double x:Key="ShareX.Density.ToolGrid.ButtonHeight">26</x:Double>
    <Thickness x:Key="ShareX.Density.ToolGrid.ButtonPadding">6,2</Thickness>
    <x:Double x:Key="ShareX.Density.ToolGrid.ItemSpacing">6</x:Double>
    <x:Double x:Key="ShareX.Density.ToolGrid.HeaderFontSize">14</x:Double>
    <Thickness x:Key="ShareX.Density.ToolGrid.HeaderMargin">7,1,7,1</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.FirstHeaderMargin">7,0,7,1</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.SeparatorMargin">7,5,7,4</Thickness>

    <!-- Avalonia Fluent menu keys -->
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">2</Thickness>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
</ResourceDictionary>
