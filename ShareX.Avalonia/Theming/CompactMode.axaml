<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The compact end of the spacing settings, close to the ShareX 21 spacing. ThemeManager blends each
        value here with the default of the same key in ControlStyles.axaml, so every key listed here needs a
        default there, and new keys need a spacing area in ThemeManager.TryGetSpacingArea.
    -->
    <x:Double x:Key="ShareX.Density.Nav.MinWidth">180</x:Double>
    <Thickness x:Key="ShareX.Density.Nav.PanelMargin">4,4,4,0</Thickness>
    <x:Double x:Key="ShareX.Density.Nav.ButtonHeight">24</x:Double>
    <Thickness x:Key="ShareX.Density.Nav.ButtonPadding">6,0</Thickness>
    <Thickness x:Key="ShareX.Density.Nav.LabelMargin">5,0,0,0</Thickness>
    <Thickness x:Key="ShareX.Density.Menu.Padding">2</Thickness>
    <x:Double x:Key="ShareX.Density.Menu.ItemHeight">22</x:Double>
    <Thickness x:Key="ShareX.Density.Menu.ItemPadding">5,0</Thickness>
    <Thickness x:Key="ShareX.Density.Menu.SeparatorMargin">4,2</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.Padding">6</Thickness>
    <x:Double x:Key="ShareX.Density.ToolGrid.ButtonHeight">26</x:Double>
    <Thickness x:Key="ShareX.Density.ToolGrid.ButtonPadding">6,2</Thickness>
    <x:Double x:Key="ShareX.Density.ToolGrid.ItemSpacing">6</x:Double>
    <x:Double x:Key="ShareX.Density.ToolGrid.HeaderFontSize">14</x:Double>
    <Thickness x:Key="ShareX.Density.ToolGrid.HeaderMargin">7,1,7,1</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.FirstHeaderMargin">7,0,7,1</Thickness>
    <Thickness x:Key="ShareX.Density.ToolGrid.SeparatorMargin">7,5,7,4</Thickness>
    <Thickness x:Key="ShareX.Density.Settings.PageMargin">18,12,18,16</Thickness>
    <Thickness x:Key="ShareX.Density.Settings.PageTitleMargin">0,0,0,8</Thickness>
    <x:Double x:Key="ShareX.Density.Settings.PageTitleFontSize">19</x:Double>
    <x:Double x:Key="ShareX.Density.Settings.PageTitleIconSize">18</x:Double>
    <x:Double x:Key="ShareX.Density.Settings.SectionTitleFontSize">14</x:Double>
    <Thickness x:Key="ShareX.Density.Settings.CardPadding">10,6</Thickness>
    <Thickness x:Key="ShareX.Density.Settings.CardMargin">0,0,0,6</Thickness>
    <x:Double x:Key="ShareX.Density.Settings.CheckBoxMinHeight">24</x:Double>
    <x:Double x:Key="ShareX.Density.Settings.ControlMinHeight">26</x:Double>
    <Thickness x:Key="ShareX.Density.Settings.ControlPadding">6,2</Thickness>
    <x:Double x:Key="ShareX.Density.Settings.NumberBoxHeight">26</x:Double>
    <Thickness x:Key="ShareX.Density.Settings.ButtonPadding">8,2</Thickness>
    <x:Double x:Key="ShareX.Density.Settings.NavItemMinHeight">24</x:Double>
    <Thickness x:Key="ShareX.Density.Settings.NavItemMargin">2,1</Thickness>
    <Thickness x:Key="ShareX.Density.Settings.SearchPadding">30,4,8,4</Thickness>
    <x:Double x:Key="ShareX.Density.Settings.NavSpacing">6</x:Double>
    <!-- Starting and minimum width of the application and task settings windows. -->
    <x:Double x:Key="ShareX.Density.Settings.WindowWidth">840</x:Double>

    <!-- Avalonia Fluent menu keys -->
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">2</Thickness>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,8,0</Thickness>
</ResourceDictionary>
