<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.tool-panel">
        <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Border.docked-top-toolbar">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="CornerRadius" Value="0,0,4,4"/>
    </Style>

    <Style Selector="Border.docked-top-toolbar > Grid">
        <Setter Property="ColumnSpacing" Value="6"/>
    </Style>

    <Style Selector="TextBlock.section-heading">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.row-label">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.path-text">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
    </Style>
</Styles>
