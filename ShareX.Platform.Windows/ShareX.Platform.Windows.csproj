<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 for hosts that run on every OS (ShareX.Desktop, tests); the Windows SDK target adds Windows Runtime features such as OCR. -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621.0</TargetFrameworks>
    <RootNamespace>ShareX.Platform.Windows</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <Description>Windows implementation of the ShareX platform services (Win32, no WinForms dependency).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShareX.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- HDR capture: Desktop Duplication (DXGI, Direct3D 11) and the WIC tone mapper (shipped in Vortice.Direct2D1). -->
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.Direct2D1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareX.Platform\ShareX.Platform.csproj" />
  </ItemGroup>
</Project>
