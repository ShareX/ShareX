<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShareX.Platform.Linux</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <Description>Linux implementation of the ShareX platform services (X11 and Wayland).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShareX.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareX.Platform\ShareX.Platform.csproj" />
  </ItemGroup>
</Project>
